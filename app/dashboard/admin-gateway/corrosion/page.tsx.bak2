'use client';

// ═══════════════════════════════════════════════════════════════════════════════
//  إدارة التآكل — Corrosion Management Dashboard
//  Route: /dashboard/admin-gateway/corrosion
// ═══════════════════════════════════════════════════════════════════════════════

import React, { useState, useEffect, useCallback, useRef } from 'react';
import {
  Upload, Activity, AlertTriangle, TrendingDown, BarChart2,
  RefreshCw, CheckCircle, XCircle, FileText, Layers,
  ZapOff, Info, Clock, Shield, Sparkles, Eye,
  Database, Briefcase, Calendar, User,
} from 'lucide-react';
import {
  LineChart, Line, BarChart, Bar, XAxis, YAxis, CartesianGrid,
  Tooltip, Legend, ResponsiveContainer, ReferenceLine, Area, AreaChart,
} from 'recharts';

// ─── Types ────────────────────────────────────────────────────────────────────

interface SummaryData {
  total_observations: number;
  status_distribution: Record<string, number>;
  risk_distribution: Record<string, number>;
  top_risk_assets: Array<{
    asset_id: string;
    risk_score: number;
    risk_classification: string;
    probability_of_failure: number;
    rle_status: string;
    rle_min_years: number;
    degradation_type_code: string;
    is_accelerating: boolean;
  }>;
  latest_observations: Array<{
    asset_id: string;
    degradation_type_code: string;
    measurement_value: number;
    measurement_timestamp: string;
    confidence_level: string;
  }>;
  prediction_accuracy: Array<{
    year: number;
    avg_error_pct: number;
    count: number;
  }>;
}

interface UploadRecord {
  upload_id: string;
  tenant_code: string;
  filename: string;
  file_type: string | null;
  engine_used: string | null;
  upload_timestamp: string;
  survey_date: string | null;
  pipeline_id: string | null;
  total_rows: number;
  inserted_rows: number;
  skipped_rows: number;
  failed_rows: number;
  processing_status: string;
  detected_header_row: number | null;
  sheets_processed: string[] | null;
  sheets_skipped: string[] | null;
  column_mapping: Record<string, string> | null;
  error_messages: string[] | null;
}

interface UploadDetail extends UploadRecord {
  cleaning_report: any;
  sample_rows: any[];
}

interface CpSession {
  session_id: string;
  file_name: string;
  survey_date: string | null;
  pipeline_id: string | null;
  start_distance: number | null;
  end_distance: number | null;
  total_points: number;
  created_at: string;
}

interface CpPipeline {
  pipeline_id: string | null;
  display_name: string;
  session_count: number;
  sessions: CpSession[];
  has_multi_survey: boolean;
}

interface CpFixedSegment {
  seg_id: string;
  start_distance: number;
  end_distance: number;
  point_count: number;
  avg_potential: number | null;
  avg_shift: number | null;
  classification: string;
  severity_score: number;
  risk_explanation: string;
  protected_pts: number;
  weak_pts: number;
  critical_pts: number;
  gis: { start_distance: number; end_distance: number; risk_level: string; severity_score: number };
}

interface CpAnalysis {
  session: CpSession;
  stats: {
    total_points: number;
    protected_count: number;
    weak_count: number;
    critical_count: number;
    protected_pct: number;
    critical_zones: number;
    max_negative_potential: number | null;
    avg_shift: number | null;
    worst_segment: { start: number; end: number; length: number } | null;
  };
  overall_status: 'GOOD' | 'WARNING' | 'CRITICAL';
  manager_summary: string;
  recommendation: string;
  risk_explanations: Record<string, string>;
  chart_data: Array<{
    distance: number | null;
    natural_potential: number | null;
    as_found: number | null;
    shift_value: number | null;
    on_potential: number | null;
    off_potential: number | null;
    protection_status: string;
    risk_level: string;
    severity_score: number;
    risk_explanation: string;
    status_field: string | null;
  }>;
  segments: Array<{
    start_distance: number;
    end_distance: number;
    status: string;
    point_count: number;
    avg_potential: number | null;
  }>;
  fixed_segments: CpFixedSegment[];
  segment_size_used: number;
}

interface CpCompareData {
  session_a: { session_id: string; file_name: string; survey_date: string | null; pipeline_id: string | null };
  session_b: { session_id: string; file_name: string; survey_date: string | null; pipeline_id: string | null };
  comparison: Array<{
    seg_id: string;
    start_distance: number;
    end_distance: number;
    session_a_avg_mv: number | null;
    session_b_avg_mv: number | null;
    delta_potential_mv: number | null;
    session_a_class: string;
    session_b_class: string;
    change: string;
  }>;
  protection_loss_zones: Array<{
    start_distance: number;
    end_distance: number;
    prev_class: string;
    curr_class: string;
    delta_potential: number | null;
  }>;
  combined_chart: Array<{ distance: number; np_a: number | null; np_b: number | null }>;
  prediction_eligible: boolean;
  prediction_note: string;
  segment_size_used: number;
}

// ─── Constants ────────────────────────────────────────────────────────────────

const API = '/api/v1/corrosion';

const RLE_COLOR: Record<string, string> = {
  ALREADY_FAILED: 'bg-red-900/60 border-red-500/60 text-red-300',
  CRITICAL:       'bg-orange-900/60 border-orange-500/60 text-orange-300',
  WARNING:        'bg-amber-900/60 border-amber-500/60 text-amber-300',
  NORMAL:         'bg-emerald-900/60 border-emerald-500/60 text-emerald-300',
  INSUFFICIENT_DATA: 'bg-slate-800/60 border-slate-600/60 text-slate-400',
};

const RISK_COLOR: Record<string, string> = {
  EXTREME:  'text-red-400',
  HIGH:     'text-orange-400',
  MODERATE: 'text-amber-400',
  LOW:      'text-emerald-400',
};

const RISK_BG: Record<string, string> = {
  EXTREME:  'bg-red-900/30 border-red-500/40',
  HIGH:     'bg-orange-900/30 border-orange-500/40',
  MODERATE: 'bg-amber-900/30 border-amber-500/40',
  LOW:      'bg-emerald-900/30 border-emerald-500/40',
};

const TYPE_LABELS: Record<string, string> = {
  EXTERNAL_CORROSION: 'تآكل خارجي',
  INTERNAL_CORROSION: 'تآكل داخلي',
  REBAR_CORROSION:    'تآكل حديد التسليح',
  CRACK_PROPAGATION:  'انتشار الشقوق',
  COATING_DEGRADATION:'تدهور الطلاء',
  SETTLEMENT:         'هبوط إنشائي',
  CP_CATHODIC_PROTECTION: 'حماية كاثودية',
  CP_AS_FOUND:        'قياس As-Found',
  CP_AS_LEFT:         'قياس As-Left',
  CP_SHIFT:           'إزاحة الجهد',
  CP_ON_POTENTIAL:    'جهد On',
  CP_OFF_POTENTIAL:   'جهد Off',
  CP_INSTANT_OFF:     'Instant Off',
  CP_PIPE_TO_SOIL:    'Pipe-to-Soil',
  CP_CURRENT:         'تيار CP',
  GENERAL_INSPECTION: 'فحص عام',
};

const STATUS_BADGE: Record<string, string> = {
  success: 'bg-emerald-900/40 border-emerald-600/40 text-emerald-300',
  partial: 'bg-amber-900/40 border-amber-600/40 text-amber-300',
  error:   'bg-red-900/40 border-red-600/40 text-red-300',
};

// ─── Helpers ─────────────────────────────────────────────────────────────────

function RleChip({ status }: { status: string | null }) {
  const s = status || 'INSUFFICIENT_DATA';
  const labels: Record<string, string> = {
    ALREADY_FAILED: 'فشل مسبق',
    CRITICAL:       'حرج',
    WARNING:        'تحذير',
    NORMAL:         'طبيعي',
    INSUFFICIENT_DATA: 'بيانات غير كافية',
  };
  return (
    <span className={`inline-block px-2 py-0.5 rounded-full text-xs font-semibold border ${RLE_COLOR[s] || RLE_COLOR['INSUFFICIENT_DATA']}`}>
      {labels[s] ?? s}
    </span>
  );
}

function RiskChip({ cls }: { cls: string | null }) {
  const c = cls || '';
  const labels: Record<string, string> = { EXTREME: 'خطر شديد', HIGH: 'عالي', MODERATE: 'متوسط', LOW: 'منخفض' };
  return (
    <span className={`inline-block px-2 py-0.5 rounded-full text-xs font-semibold border ${RISK_BG[c] || 'bg-slate-800 border-slate-700'} ${RISK_COLOR[c] || 'text-slate-400'}`}>
      {labels[c] ?? (c || '—')}
    </span>
  );
}

// ─── Main Component ───────────────────────────────────────────────────────────

type Tab = 'sessions' | 'analysis' | 'segments' | 'compare' | 'prediction' | 'scenarios';

export default function CorrosionPage() {
  const [activeTab, setActiveTab] = useState<Tab>('sessions');  const [showUploadPanel, setShowUploadPanel] = useState(false);
  const [summary, setSummary] = useState<SummaryData | null>(null);
  const [summaryLoading, setSummaryLoading] = useState(true);
  const [uploads, setUploads] = useState<UploadRecord[]>([]);
  const [uploadsLoading, setUploadsLoading] = useState(false);
  const [selectedUpload, setSelectedUpload] = useState<UploadDetail | null>(null);
  const [viewMode, setViewMode] = useState<'specialist' | 'manager'>('specialist');
  const [cpSessions, setCpSessions] = useState<CpSession[]>([]);
  const [cpSessionsLoading, setCpSessionsLoading] = useState(false);
  const [selectedCpSession, setSelectedCpSession] = useState<string | null>(null);
  const [cpAnalysis, setCpAnalysis] = useState<CpAnalysis | null>(null);
  const [cpAnalysisLoading, setCpAnalysisLoading] = useState(false);
  const [cpPipelines, setCpPipelines] = useState<CpPipeline[]>([]);
  const [cpPipelinesLoading, setCpPipelinesLoading] = useState(false);
  const [selectedPipeline, setSelectedPipeline] = useState<string | null>(null);
  const [segmentSize, setSegmentSize] = useState(100);
  const [compareSessionA, setCompareSessionA] = useState<string | null>(null);
  const [compareSessionB, setCompareSessionB] = useState<string | null>(null);
  const [cpCompareData, setCpCompareData] = useState<CpCompareData | null>(null);
  const [cpCompareLoading, setCpCompareLoading] = useState(false);

  const fetchSummary = useCallback(async () => {
    setSummaryLoading(true);
    try {
      const r = await fetch(`${API}/summary`);
      if (r.ok) setSummary(await r.json());
    } finally {
      setSummaryLoading(false);
    }
  }, []);

  const fetchUploads = useCallback(async () => {
    setUploadsLoading(true);
    try {
      const r = await fetch(`${API}/uploads?limit=50`);
      if (r.ok) { const d = await r.json(); setUploads(d.uploads ?? []); }
    } finally { setUploadsLoading(false); }
  }, []);

  const fetchCpSessions = useCallback(async () => {
    setCpSessionsLoading(true);
    try {
      const r = await fetch(`${API}/cp-sessions`);
      if (r.ok) { const d = await r.json(); setCpSessions(d.sessions ?? []); }
    } finally { setCpSessionsLoading(false); }
  }, []);

  const fetchCpPipelines = useCallback(async () => {
    setCpPipelinesLoading(true);
    try {
      const r = await fetch(`${API}/cp-pipelines`);
      if (r.ok) { const d = await r.json(); setCpPipelines(d.pipelines ?? []); }
    } finally { setCpPipelinesLoading(false); }
  }, []);

  const fetchCpAnalysis = useCallback(async (sessionId: string, size?: number) => {
    setCpAnalysisLoading(true);
    setCpAnalysis(null);
    try {
      const sz = size ?? segmentSize;
      const r = await fetch(`${API}/cp-analysis/${sessionId}?segment_size=${sz}`);
      if (r.ok) setCpAnalysis(await r.json());
    } finally { setCpAnalysisLoading(false); }
  }, [segmentSize]);

  const fetchCpCompare = useCallback(async (a: string, b: string, size?: number) => {
    setCpCompareLoading(true);
    setCpCompareData(null);
    try {
      const sz = size ?? segmentSize;
      const r = await fetch(`${API}/cp-compare?session_a=${a}&session_b=${b}&segment_size=${sz}`);
      if (r.ok) setCpCompareData(await r.json());
    } finally { setCpCompareLoading(false); }
  }, [segmentSize]);

  const fetchUploadDetail = useCallback(async (id: string) => {
    const r = await fetch(`${API}/uploads/${id}`);
    if (r.ok) setSelectedUpload(await r.json());
  }, []);

  useEffect(() => { fetchSummary(); }, [fetchSummary]);

  useEffect(() => {
    if (activeTab === 'sessions')  { fetchUploads(); fetchCpPipelines(); }
    if (activeTab === 'analysis')  fetchCpPipelines();
    if (activeTab === 'segments')  fetchCpPipelines();
    if (activeTab === 'compare')   fetchCpPipelines();
    if (activeTab === 'prediction') fetchCpPipelines();
  }, [activeTab, fetchUploads, fetchCpPipelines]);

  useEffect(() => {
    if (selectedCpSession) fetchCpAnalysis(selectedCpSession, segmentSize);
  }, [selectedCpSession, segmentSize, fetchCpAnalysis]);

  useEffect(() => {
    if (compareSessionA && compareSessionB) fetchCpCompare(compareSessionA, compareSessionB, segmentSize);
  }, [compareSessionA, compareSessionB, segmentSize, fetchCpCompare]);

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 p-4 md:p-6" dir="rtl">
      <div className="max-w-7xl mx-auto space-y-5">

        {/* ── Header ─────────────────────────────────────────────────────── */}
        <div className="flex items-center justify-between bg-slate-900/60 rounded-2xl border border-slate-800 p-5">
          <div className="flex items-center gap-4">
            <div className="w-14 h-14 rounded-xl bg-orange-500/10 border border-orange-500/30 flex items-center justify-center shrink-0">
              <ZapOff className="w-7 h-7 text-orange-400" />
            </div>
            <div>
              <h1 className="text-2xl font-bold text-white">إدارة التآكل</h1>
              <p className="text-sm text-slate-400 mt-0.5">
                استيراد وتحليل مسوحات الحماية الكاثودية CP — مقارنة متعددة السنوات — NACE SP0169
              </p>
            </div>
          </div>
          <div className="flex items-center gap-3">
            <div className="flex items-center gap-1 bg-slate-800/60 rounded-xl border border-slate-700 p-1">
              <button onClick={() => setViewMode('specialist')}
                className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${viewMode === 'specialist' ? 'bg-blue-600/30 text-blue-300 border border-blue-500/40' : 'text-slate-500 hover:text-slate-300'}`}>
                <User className="w-3.5 h-3.5" /> متخصص
              </button>
              <button onClick={() => setViewMode('manager')}
                className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${viewMode === 'manager' ? 'bg-emerald-600/30 text-emerald-300 border border-emerald-500/40' : 'text-slate-500 hover:text-slate-300'}`}>
                <Briefcase className="w-3.5 h-3.5" /> مدير
              </button>
            </div>
            <button
              onClick={fetchSummary}
              disabled={summaryLoading}
              className="flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-sm text-slate-300 transition-colors disabled:opacity-50"
            >
              <RefreshCw className={`w-4 h-4 ${summaryLoading ? 'animate-spin' : ''}`} />
              تحديث
            </button>
          </div>
        </div>

        {/* ── CP Network KPI Strip ─────────────────────────────────────────── */}
        {!cpPipelinesLoading && cpPipelines.length > 0 && (() => {
          const totalSessions = cpPipelines.reduce((a, p) => a + p.session_count, 0);
          const multiSurveyPipelines = cpPipelines.filter(p => p.has_multi_survey).length;
          const pipelinesWithSessions = cpPipelines.filter(p => p.session_count > 0).length;
          return (
            <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
              <div className="bg-slate-900/50 rounded-xl border border-cyan-500/30 p-4">
                <div className="flex items-center gap-2 mb-1"><Database className="w-4 h-4 text-cyan-400" /><p className="text-xs text-slate-400">إجمالي الجلسات المستورَدة</p></div>
                <p className="text-2xl font-bold text-white">{totalSessions}</p>
              </div>
              <div className="bg-slate-900/50 rounded-xl border border-blue-500/30 p-4">
                <div className="flex items-center gap-2 mb-1"><Activity className="w-4 h-4 text-blue-400" /><p className="text-xs text-slate-400">خطوط مُسَّحة</p></div>
                <p className="text-2xl font-bold text-white">{pipelinesWithSessions}</p>
              </div>
              <div className="bg-slate-900/50 rounded-xl border border-orange-500/30 p-4">
                <div className="flex items-center gap-2 mb-1"><AlertTriangle className="w-4 h-4 text-orange-400" /><p className="text-xs text-slate-400">مناطق حرجة (آخر تحليل)</p></div>
                <p className="text-2xl font-bold text-white">{cpAnalysis ? cpAnalysis.stats.critical_zones : '—'}</p>
              </div>
              <div className="bg-slate-900/50 rounded-xl border border-purple-500/30 p-4">
                <div className="flex items-center gap-2 mb-1"><TrendingDown className="w-4 h-4 text-purple-400" /><p className="text-xs text-slate-400">خطوط مؤهلة للتنبؤ</p></div>
                <p className="text-2xl font-bold text-white">{multiSurveyPipelines}</p>
              </div>
            </div>
          );
        })()}

        {/* ── Manager CP Overview Banner ────────────────────────────────────── */}
        {viewMode === 'manager' && !cpPipelinesLoading && cpPipelines.length > 0 && (() => {
          const totalSessions = cpPipelines.reduce((a, p) => a + p.session_count, 0);
          const multiSurvey   = cpPipelines.filter(p => p.has_multi_survey).length;
          const hasCritical   = cpAnalysis && cpAnalysis.stats.critical_zones > 0;
          const overallStatus = cpAnalysis?.overall_status ?? null;
          return (
            <div className={`rounded-2xl border p-5 ${hasCritical || overallStatus === 'CRITICAL' ? 'bg-red-900/20 border-red-600/30' : overallStatus === 'WARNING' ? 'bg-amber-900/20 border-amber-600/30' : 'bg-emerald-900/20 border-emerald-600/30'}`}>
              <div className="flex items-start gap-3">
                <div className={`p-2.5 rounded-xl ${hasCritical ? 'bg-red-500/20' : 'bg-emerald-500/20'}`}>
                  <Briefcase className={`w-5 h-5 ${hasCritical ? 'text-red-400' : 'text-emerald-400'}`} />
                </div>
                <div className="flex-1">
                  <h3 className={`font-bold text-base mb-1 ${hasCritical ? 'text-red-200' : 'text-emerald-200'}`}>ملخص شبكة الحماية الكاثودية</h3>
                  {cpAnalysis ? (
                    <p className={`text-sm ${hasCritical ? 'text-red-300' : 'text-emerald-300'}`}>{cpAnalysis.manager_summary}</p>
                  ) : (
                    <p className="text-sm text-slate-300">{totalSessions} جلسة مسح مستورَدة على {cpPipelines.length} خط — {multiSurvey > 0 ? `${multiSurvey} خط مؤهل للتنبؤ الزمني` : 'لا توجد خطوط مؤهلة للتنبؤ بعد'}</p>
                  )}
                  {cpAnalysis && (
                    <p className="text-xs text-slate-400 mt-2 flex items-center gap-2">
                      <Shield className="w-3.5 h-3.5" />
                      {cpAnalysis.recommendation}
                    </p>
                  )}
                </div>
                {cpAnalysis && (
                  <div className={`text-3xl font-bold px-4 py-2 rounded-xl ${hasCritical ? 'bg-red-900/30 text-red-300' : overallStatus === 'WARNING' ? 'bg-amber-900/30 text-amber-300' : 'bg-emerald-900/30 text-emerald-300'}`}>
                    {cpAnalysis.stats.protected_pct}%
                    <p className="text-xs font-normal text-center mt-0.5">محمية</p>
                  </div>
                )}
              </div>
            </div>
          );
        })()}

        {/* ── Tabs ─────────────────────────────────────────────────────────── */}
        <div className="flex gap-1 bg-slate-900/50 rounded-xl border border-slate-800 p-1 overflow-x-auto">
          {([
            { id: 'sessions',    label: 'جلسات المسح',       icon: <Database className="w-4 h-4" /> },
            { id: 'analysis',    label: 'تحليل المسح',       icon: <Activity className="w-4 h-4" /> },
            { id: 'segments',    label: 'المقاطع',           icon: <Layers className="w-4 h-4" /> },
            { id: 'compare',     label: 'مقارنة المسوحات',   icon: <BarChart2 className="w-4 h-4" /> },
            { id: 'prediction',  label: 'التنبؤ',            icon: <TrendingDown className="w-4 h-4" /> },
            { id: 'scenarios',   label: 'السيناريوهات',      icon: <Sparkles className="w-4 h-4" /> },
          ] as { id: Tab; label: string; icon: React.ReactNode }[]).map(t => (
            <button
              key={t.id}
              onClick={() => setActiveTab(t.id)}
              className={`flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium whitespace-nowrap transition-all ${
                activeTab === t.id
                  ? 'bg-orange-500/20 text-orange-300 border border-orange-500/30 shadow-sm'
                  : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50'
              }`}
            >
              {t.icon}{t.label}
            </button>
          ))}
        </div>

        {/* ══════════════════════════════════════════════════════════════════ */}
        {/* TAB 1: جلسات المسح                                               */}
        {/* ══════════════════════════════════════════════════════════════════ */}
        {activeTab === 'sessions' && (
          <div className="space-y-4">
            {/* Import action */}
            <div className="bg-slate-900/50 rounded-2xl border border-slate-800 overflow-hidden">
              <div className="px-5 py-4 flex items-center justify-between">
                <div>
                  <h2 className="text-lg font-semibold text-white">جلسات المسح</h2>
                  <p className="text-xs text-slate-500 mt-0.5">كل سطر = جلسة مسح CP مُستورَدة — اضغط «تحليل» للانتقال إلى فضاء التحليل الهندسي</p>
                </div>
                <div className="flex items-center gap-2">
                  <button onClick={() => { fetchUploads(); fetchCpPipelines(); }} disabled={uploadsLoading}
                    className="text-sm text-slate-400 hover:text-white flex items-center gap-1 disabled:opacity-50">
                    <RefreshCw className={`w-3.5 h-3.5 ${uploadsLoading ? 'animate-spin' : ''}`} /> تحديث
                  </button>
                  <button
                    onClick={() => setShowUploadPanel(!showUploadPanel)}
                    className={`flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold transition-all ${showUploadPanel ? 'bg-orange-600/30 text-orange-300 border border-orange-500/40' : 'bg-orange-500/10 hover:bg-orange-500/20 border border-orange-500/30 text-orange-300'}`}
                  >
                    <Upload className="w-4 h-4" /> استيراد مسح جديد
                  </button>
                </div>
              </div>

              {/* Collapsible upload panel */}
              {showUploadPanel && (
                <div className="border-t border-slate-800 p-5">
                  <UploadPanel onSuccess={() => { fetchUploads(); fetchCpPipelines(); setShowUploadPanel(false); }} />
                </div>
              )}
            </div>

            {/* Upload detail panel */}
            {selectedUpload && (
              <UploadDetailPanel detail={selectedUpload} viewMode={viewMode} onClose={() => setSelectedUpload(null)} />
            )}

            {/* Sessions table */}
            <div className="bg-slate-900/50 rounded-2xl border border-slate-800 overflow-hidden">
              {uploadsLoading ? (
                <div className="flex justify-center py-12"><RefreshCw className="w-6 h-6 text-orange-400 animate-spin" /></div>
              ) : uploads.length === 0 ? (
                <div className="py-12 text-center text-slate-500">
                  <Database className="w-12 h-12 mx-auto mb-3 opacity-40" />
                  <p className="mb-4">لا توجد جلسات مُستورَدة بعد</p>
                  <button onClick={() => setShowUploadPanel(true)}
                    className="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-orange-500/10 border border-orange-500/30 text-orange-300 text-sm font-medium">
                    <Upload className="w-4 h-4" /> استورد أول ملف مسح CP
                  </button>
                </div>
              ) : (
                <div className="overflow-x-auto">
                  <table className="w-full text-sm">
                    <thead>
                      <tr className="border-b border-slate-800 bg-slate-800/30">
                        {['اسم الملف', 'الخط', 'تاريخ المسح', 'نطاق المسافة', 'نقاط القياس', 'حالة المعالجة', 'إجراءات'].map(h => (
                          <th key={h} className="px-4 py-3 text-right text-xs text-slate-400 font-semibold">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {uploads.map((u) => {
                        const matchSession = cpPipelines.flatMap(p => p.sessions).find(s => s.file_name === u.filename);
                        return (
                          <tr key={u.upload_id} className="border-b border-slate-800/50 hover:bg-slate-800/20 transition-colors">
                            <td className="px-4 py-3">
                              <div className="flex items-center gap-2">
                                <FileText className="w-4 h-4 text-slate-500 shrink-0" />
                                <div>
                                  <p className="text-slate-200 font-medium max-w-[180px] truncate">{u.filename}</p>
                                  <p className="text-xs text-slate-500 mt-0.5">{new Date(u.upload_timestamp).toLocaleDateString('ar-LY')}</p>
                                </div>
                              </div>
                            </td>
                            <td className="px-4 py-3">
                              {u.pipeline_id
                                ? <span className="px-2 py-0.5 rounded-md bg-blue-900/30 border border-blue-500/30 text-blue-300 text-xs font-mono">{u.pipeline_id}</span>
                                : <span className="text-slate-600 text-xs">غير محدد</span>}
                            </td>
                            <td className="px-4 py-3 text-slate-300 font-medium">{u.survey_date ?? <span className="text-slate-600">—</span>}</td>
                            <td className="px-4 py-3 text-xs font-mono text-slate-400">
                              {matchSession?.start_distance != null ? `${matchSession.start_distance} → ${matchSession.end_distance} م` : '—'}
                            </td>
                            <td className="px-4 py-3 text-cyan-400 font-bold">{matchSession?.total_points.toLocaleString() ?? u.inserted_rows.toLocaleString()}</td>
                            <td className="px-4 py-3">
                              <span className={`px-2 py-0.5 rounded-md text-xs border font-medium ${STATUS_BADGE[u.processing_status] ?? STATUS_BADGE['error']}`}>
                                {u.processing_status === 'success' ? '✓ نجاح' : u.processing_status === 'partial' ? '⚠ جزئي' : '✗ خطأ'}
                              </span>
                            </td>
                            <td className="px-4 py-3">
                              <div className="flex items-center gap-2">
                                {matchSession && (
                                  <button
                                    onClick={() => { setSelectedPipeline(u.pipeline_id ?? null); setSelectedCpSession(matchSession.session_id); setCpAnalysis(null); setActiveTab('analysis'); }}
                                    className="flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-orange-500/10 hover:bg-orange-500/20 border border-orange-500/30 text-xs text-orange-300 font-semibold transition-colors">
                                    <Activity className="w-3.5 h-3.5" /> تحليل
                                  </button>
                                )}
                                <button
                                  onClick={() => fetchUploadDetail(u.upload_id)}
                                  className="flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-xs text-slate-300 transition-colors">
                                  <Eye className="w-3.5 h-3.5" /> تفاصيل
                                </button>
                              </div>
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </div>
        )}

        {/* ══════════════════════════════════════════════════════════════════ */}
        {/* TAB 2: تحليل المسح                                               */}
        {/* ══════════════════════════════════════════════════════════════════ */}
        {activeTab === 'analysis' && (
          <CpAnalysisTab
            pipelines={cpPipelines}
            pipelinesLoading={cpPipelinesLoading}
            selectedPipeline={selectedPipeline}
            onSelectPipeline={(pid) => { setSelectedPipeline(pid); setSelectedCpSession(null); setCpAnalysis(null); }}
            selectedSession={selectedCpSession}
            onSelectSession={setSelectedCpSession}
            analysis={cpAnalysis}
            analysisLoading={cpAnalysisLoading}
            segmentSize={segmentSize}
            onSegmentSizeChange={setSegmentSize}
            viewMode={viewMode}
            onRefresh={fetchCpPipelines}
            onOpenSegments={() => setActiveTab('segments')}
          />
        )}

        {/* ══════════════════════════════════════════════════════════════════ */}
        {/* TAB 3: المقاطع                                                    */}
        {/* ══════════════════════════════════════════════════════════════════ */}
        {activeTab === 'segments' && (
          <SegmentsTab
            analysis={cpAnalysis}
            analysisLoading={cpAnalysisLoading}
            viewMode={viewMode}
            onGoToAnalysis={() => setActiveTab('analysis')}
          />
        )}

        {/* ══════════════════════════════════════════════════════════════════ */}
        {/* TAB 4: مقارنة المسوحات                                           */}
        {/* ══════════════════════════════════════════════════════════════════ */}
        {activeTab === 'compare' && (
          <CpCompareTab
            pipelines={cpPipelines}
            pipelinesLoading={cpPipelinesLoading}
            selectedPipeline={selectedPipeline}
            onSelectPipeline={(pid) => { setSelectedPipeline(pid); setCompareSessionA(null); setCompareSessionB(null); setCpCompareData(null); }}
            segmentSize={segmentSize}
            onSegmentSizeChange={setSegmentSize}
            compareSessionA={compareSessionA}
            compareSessionB={compareSessionB}
            onCompareSessionAChange={setCompareSessionA}
            onCompareSessionBChange={setCompareSessionB}
            compareData={cpCompareData}
            compareLoading={cpCompareLoading}
            onRefresh={fetchCpPipelines}
          />
        )}

        {/* ══════════════════════════════════════════════════════════════════ */}
        {/* TAB 5: التنبؤ                                                     */}
        {/* ══════════════════════════════════════════════════════════════════ */}
        {activeTab === 'prediction' && (
          <PredictionTab
            pipelines={cpPipelines}
            pipelinesLoading={cpPipelinesLoading}
            selectedPipeline={selectedPipeline}
            onSelectPipeline={(pid) => { setSelectedPipeline(pid); setCompareSessionA(null); setCompareSessionB(null); setCpCompareData(null); }}
            segmentSize={segmentSize}
            onSegmentSizeChange={setSegmentSize}
            compareSessionA={compareSessionA}
            compareSessionB={compareSessionB}
            onCompareSessionAChange={setCompareSessionA}
            onCompareSessionBChange={setCompareSessionB}
            compareData={cpCompareData}
            compareLoading={cpCompareLoading}
            viewMode={viewMode}
            onGoToSessions={() => setActiveTab('sessions')}
            onRefresh={fetchCpPipelines}
          />
        )}

        {/* ══════════════════════════════════════════════════════════════════ */}
        {/* TAB 6: السيناريوهات                                               */}
        {/* ══════════════════════════════════════════════════════════════════ */}
        {activeTab === 'scenarios' && (
          <ScenariosTab
            analysis={cpAnalysis}
            pipelines={cpPipelines}
            viewMode={viewMode}
            onGoToAnalysis={() => setActiveTab('analysis')}
          />
        )}

      </div>
    </div>
  );
}

// ─── CP Analysis Tab Component ───────────────────────────────────────────────

const CP_STATUS_CONFIG = {
  PROTECTED: { label: 'محمية',       color: 'text-emerald-400', bg: 'bg-emerald-900/30 border-emerald-500/40', dot: '#10b981', bar: 'bg-emerald-500' },
  WEAK:      { label: 'ضعيفة',       color: 'text-amber-400',   bg: 'bg-amber-900/30 border-amber-500/40',   dot: '#f59e0b', bar: 'bg-amber-500'   },
  CRITICAL:  { label: 'حرجة',        color: 'text-red-400',     bg: 'bg-red-900/30 border-red-500/40',       dot: '#ef4444', bar: 'bg-red-500'     },
  UNKNOWN:   { label: 'غير معروف',   color: 'text-slate-400',   bg: 'bg-slate-800/60 border-slate-600/40',  dot: '#64748b', bar: 'bg-slate-600'   },
};

const OVERALL_STATUS_CONFIG = {
  GOOD:     { label: 'جيد',    bg: 'bg-emerald-900/30 border-emerald-500/40', text: 'text-emerald-200', icon: '✅' },
  WARNING:  { label: 'تحذير', bg: 'bg-amber-900/30 border-amber-500/40',    text: 'text-amber-200',   icon: '⚠️' },
  CRITICAL: { label: 'خطير',  bg: 'bg-red-900/30 border-red-500/40',        text: 'text-red-200',     icon: '🚨' },
};

const CHANGE_CONFIG: Record<string, { label: string; color: string }> = {
  stable:               { label: 'مستقر',          color: 'text-slate-400' },
  improved:             { label: '▲ تحسن',          color: 'text-emerald-400' },
  degraded:             { label: '▼ تدهور',         color: 'text-amber-400' },
  degraded_to_critical: { label: '▼▼ تدهور حرج',   color: 'text-red-400' },
  protection_loss:      { label: '⚠ فقدان حماية', color: 'text-red-400' },
};

function CpAnalysisTab({
  pipelines, pipelinesLoading,
  selectedPipeline, onSelectPipeline,
  selectedSession, onSelectSession,
  analysis, analysisLoading,
  segmentSize, onSegmentSizeChange,
  viewMode, onRefresh, onOpenSegments,
}: {
  pipelines: CpPipeline[];
  pipelinesLoading: boolean;
  selectedPipeline: string | null;
  onSelectPipeline: (id: string | null) => void;
  selectedSession: string | null;
  onSelectSession: (id: string) => void;
  analysis: CpAnalysis | null;
  analysisLoading: boolean;
  segmentSize: number;
  onSegmentSizeChange: (s: number) => void;
  viewMode: 'specialist' | 'manager';
  onRefresh: () => void;
  onOpenSegments?: () => void;
}) {
  const [showRiskLegend, setShowRiskLegend] = React.useState(false);

  const activePipeline = pipelines.find(p =>
    (p.pipeline_id ?? '__UNASSIGNED__') === (selectedPipeline ?? '__UNASSIGNED__')
  ) ?? null;
  const pipelineSessions = activePipeline?.sessions ?? [];

  // For chart: sample to max 300 points
  const chartSample = React.useMemo(() => {
    if (!analysis) return [];
    const pts = analysis.chart_data.filter(p => p.distance !== null);
    const n = pts.length;
    if (n <= 300) return pts;
    const step = Math.ceil(n / 300);
    return pts.filter((_, i) => i % step === 0);
  }, [analysis]);

  const segCfg = (s: string) => CP_STATUS_CONFIG[s as keyof typeof CP_STATUS_CONFIG] ?? CP_STATUS_CONFIG.UNKNOWN;

  return (
    <div className="space-y-4">

      {/* ── Top control bar ───────────────────────────────────────────────── */}
      <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-5 space-y-4">
        {/* Title row */}
        <div className="flex items-center justify-between flex-wrap gap-3">
          <h3 className="text-base font-semibold text-white flex items-center gap-2">
            <Activity className="w-5 h-5 text-cyan-400" />
            نظام تحليل الحماية الكاثودية
          </h3>
          <button onClick={onRefresh} disabled={pipelinesLoading}
            className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs text-slate-300 transition-colors disabled:opacity-50">
            <RefreshCw className={`w-3.5 h-3.5 ${pipelinesLoading ? 'animate-spin' : ''}`} /> تحديث
          </button>
        </div>

        {/* Pipeline selector */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
          <div>
            <label className="block text-xs text-slate-400 mb-1">الخط</label>
            {pipelinesLoading ? (
              <div className="h-9 bg-slate-800 rounded-lg animate-pulse" />
            ) : (
              <select
                value={selectedPipeline ?? ''}
                onChange={e => onSelectPipeline(e.target.value || null)}
                className="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:border-cyan-500 focus:outline-none"
              >
                <option value="">— اختر الخط —</option>
                {pipelines.map(p => (
                  <option key={p.pipeline_id ?? '__UNASSIGNED__'} value={p.pipeline_id ?? ''}>
                    {p.display_name}
                    {p.has_multi_survey ? ' ✓ متعدد' : ''} ({p.session_count} مسح)
                  </option>
                ))}
              </select>
            )}
          </div>

          {/* Session selector */}
          {(selectedPipeline !== null || pipelineSessions.length > 0) ? (
            <div>
              <label className="block text-xs text-slate-400 mb-1">جلسة المسح</label>
              <select
                value={selectedSession ?? ''}
                onChange={e => onSelectSession(e.target.value)}
                disabled={!activePipeline}
                className="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:border-cyan-500 focus:outline-none disabled:opacity-50"
              >
                <option value="">— اختر المسح —</option>
                {pipelineSessions.map(s => (
                  <option key={s.session_id} value={s.session_id}>
                    {s.survey_date ? `${s.survey_date} — ` : ''}{s.file_name} ({s.total_points} نقطة)
                  </option>
                ))}
              </select>
            </div>
          ) : null}

          {/* Segment size */}
          <div>
            <label className="block text-xs text-slate-400 mb-1">حجم المقطع التحليلي (م)</label>
            <div className="flex items-center gap-2">
              <input
                type="number" min={10} max={1000} step={10}
                value={segmentSize}
                onChange={e => onSegmentSizeChange(Math.max(10, Math.min(1000, Number(e.target.value))))}
                className="w-24 bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:border-cyan-500 focus:outline-none"
              />
              <span className="text-xs text-slate-500">الافتراضي: 100 م</span>
            </div>
          </div>
        </div>



        {/* Risk legend toggle */}
        <button onClick={() => setShowRiskLegend(!showRiskLegend)}
          className="flex items-center gap-2 text-xs text-cyan-400 hover:text-cyan-300 transition-colors">
          <Info className="w-3.5 h-3.5" />
          {showRiskLegend ? 'إخفاء' : 'عرض'} مستويات الخطر وتفسيرها
        </button>
        {showRiskLegend && (
          <div className="grid grid-cols-1 md:grid-cols-3 gap-2 pt-1">
            {[
              { key: 'PROTECTED', threshold: 'الجهد < −850 mV',  explanation: 'حماية كاثودية جيدة وفق معيار NACE SP0169' },
              { key: 'WEAK',      threshold: '−850 ≤ الجهد < −700 mV', explanation: 'حماية غير مستقرة — يُوصى بمراجعة نظام CP' },
              { key: 'CRITICAL',  threshold: 'الجهد > −700 mV',  explanation: 'لا توجد حماية فعالة — خطر تآكل مباشر' },
            ].map(item => {
              const cfg = CP_STATUS_CONFIG[item.key as keyof typeof CP_STATUS_CONFIG];
              return (
                <div key={item.key} className={`rounded-xl border p-3 ${cfg.bg}`}>
                  <div className={`flex items-center gap-2 mb-1 font-semibold text-xs ${cfg.color}`}>
                    <span className="w-2.5 h-2.5 rounded-full inline-block" style={{ backgroundColor: cfg.dot }} />
                    {cfg.label}: {item.threshold}
                  </div>
                  <p className="text-xs text-slate-400">{item.explanation}</p>
                </div>
              );
            })}
          </div>
        )}
      </div>

      {/* ── No pipeline selected ──────────────────────────────────────────── */}
      {!selectedPipeline && !pipelinesLoading && pipelines.length === 0 && (
        <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-10 text-center text-slate-500">
          لا توجد بيانات مسح CP — استورد ملف مسح من تبويب «استيراد مسح جديد».
        </div>
      )}

      {/* SINGLE ANALYSIS MODE                                              */}
      {/* ══════════════════════════════════════════════════════════════════ */}
      {selectedSession && (
        analysisLoading ? (
          <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-10 text-center">
            <div className="inline-flex items-center gap-3 text-slate-400">
              <RefreshCw className="w-5 h-5 animate-spin" />
              جاري التحليل الهندسي…
            </div>
          </div>
        ) : analysis ? (
          <div className="space-y-4">

            {/* ── Manager View ─────────────────────────────────────────── */}
            {viewMode === 'manager' && (() => {
              const cfg = OVERALL_STATUS_CONFIG[analysis.overall_status] ?? OVERALL_STATUS_CONFIG.CRITICAL;
              return (
                <div className={`rounded-2xl border p-6 ${cfg.bg}`}>
                  <div className="flex items-start gap-4">
                    <span className="text-4xl">{cfg.icon}</span>
                    <div className="flex-1">
                      <p className="text-xs text-slate-400 mb-1">الوضع العام للحماية الكاثودية — {analysis.session.pipeline_id ?? 'خط غير محدد'}</p>
                      <h2 className={`text-3xl font-bold mb-2 ${cfg.text}`}>{cfg.label}</h2>
                      <p className={`text-base leading-relaxed mb-3 ${cfg.text}`}>{analysis.manager_summary}</p>
                      <div className="flex items-start gap-2 border-t border-current/20 pt-3">
                        <Shield className="w-4 h-4 mt-0.5 shrink-0 opacity-70" />
                        <p className={`text-sm ${cfg.text} opacity-90`}><strong>التوصية: </strong>{analysis.recommendation}</p>
                      </div>
                      <div className="grid grid-cols-2 md:grid-cols-4 gap-3 mt-4">
                        {[
                          { label: 'إجمالي نقاط القياس', value: analysis.stats.total_points },
                          { label: 'نقاط محمية', value: `${analysis.stats.protected_count} (${analysis.stats.protected_pct}%)` },
                          { label: 'مناطق حرجة', value: analysis.stats.critical_zones },
                          { label: 'نقاط دون حماية', value: analysis.stats.critical_count + analysis.stats.weak_count },
                        ].map((kpi, i) => (
                          <div key={i} className="bg-black/20 rounded-xl p-3 text-center">
                            <p className="text-xs text-slate-400 mb-1">{kpi.label}</p>
                            <p className={`text-xl font-bold ${cfg.text}`}>{kpi.value}</p>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              );
            })()}

            {/* ── Specialist View ──────────────────────────────────────── */}
            {viewMode === 'specialist' && (
              <>
                {/* KPI strip */}
                <div className="grid grid-cols-2 md:grid-cols-5 gap-3">
                  {[
                    { label: 'إجمالي نقاط القياس', value: analysis.stats.total_points.toLocaleString(), color: 'border-cyan-500/30',    icon: <Activity className="w-4 h-4 text-cyan-400" /> },
                    { label: 'نسبة الحماية',        value: `${analysis.stats.protected_pct}%`,           color: 'border-emerald-500/30', icon: <Shield className="w-4 h-4 text-emerald-400" /> },
                    { label: 'مناطق حرجة متتالية',  value: analysis.stats.critical_zones,                color: 'border-red-500/30',     icon: <AlertTriangle className="w-4 h-4 text-red-400" /> },
                    { label: 'أقصى جهد سلبي (mV)',   value: analysis.stats.max_negative_potential != null ? analysis.stats.max_negative_potential.toFixed(0) : '—', color: 'border-orange-500/30', icon: <ZapOff className="w-4 h-4 text-orange-400" /> },
                    { label: 'متوسط الإزاحة (mV)',    value: analysis.stats.avg_shift != null ? `${analysis.stats.avg_shift.toFixed(1)}` : '—', color: 'border-purple-500/30', icon: <TrendingDown className="w-4 h-4 text-purple-400" /> },
                  ].map((kpi, i) => (
                    <div key={i} className={`bg-slate-900/50 rounded-xl border ${kpi.color} p-4`}>
                      <div className="flex items-center gap-2 mb-1">{kpi.icon}<p className="text-xs text-slate-400">{kpi.label}</p></div>
                      <p className="text-2xl font-bold text-white">{kpi.value}</p>
                    </div>
                  ))}
                </div>

                {/* Pipeline heatmap */}
                <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-5">
                  <h3 className="text-sm font-semibold text-slate-300 mb-1 flex items-center gap-2">
                    خريطة الخط الحرارية — توزيع الحماية
                    <span className="text-xs text-slate-500 font-normal">({analysis.fixed_segments.length} مقطع × {analysis.segment_size_used} م)</span>
                  </h3>
                  <p className="text-xs text-slate-500 mb-3">كل خلية = مقطع {analysis.segment_size_used} م — اللون يعكس متوسط حالة الحماية</p>

                  {/* Heatmap row */}
                  <div className="flex h-10 rounded-lg overflow-hidden gap-px">
                    {analysis.fixed_segments.map((seg) => {
                      const cfg = segCfg(seg.classification);
                      return (
                        <div key={seg.seg_id}
                          style={{ backgroundColor: cfg.dot, minWidth: 4 }}
                          className="h-full flex-1 cursor-pointer hover:brightness-125 transition-[filter]"
                          title={`${seg.start_distance}–${seg.end_distance} م\n${cfg.label}\nمتوسط الجهد: ${seg.avg_potential != null ? seg.avg_potential.toFixed(0) + ' mV' : '—'}\n${seg.risk_explanation}`}
                        />
                      );
                    })}
                  </div>

                  {/* Distance axis labels */}
                  <div className="flex justify-between mt-1 text-xs text-slate-600">
                    <span>{analysis.session.start_distance != null ? `${analysis.session.start_distance} م` : '0 م'}</span>
                    <span>{analysis.session.end_distance != null ? `${analysis.session.end_distance} م` : ''}</span>
                  </div>

                  {/* Legend */}
                  <div className="flex gap-4 mt-2">
                    {(['PROTECTED', 'WEAK', 'CRITICAL'] as const).map(k => (
                      <span key={k} className={`text-xs flex items-center gap-1.5 ${CP_STATUS_CONFIG[k].color}`}>
                        <span className="w-3 h-3 rounded inline-block" style={{ backgroundColor: CP_STATUS_CONFIG[k].dot }} />
                        {CP_STATUS_CONFIG[k].label}
                      </span>
                    ))}
                  </div>
                </div>

                {/* Potential over distance */}
                <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-5">
                  <h3 className="text-base font-semibold text-white mb-1">الجهد الكهروكيميائي على طول الخط (mV)</h3>
                  <p className="text-xs text-slate-500 mb-4">الخط الأحمر المنقط = −850 mV (حد الحماية — NACE SP0169)</p>
                  <ResponsiveContainer width="100%" height={300}>
                    <LineChart data={chartSample} margin={{ top: 5, right: 20, left: 10, bottom: 15 }}>
                      <CartesianGrid strokeDasharray="3 3" stroke="#334155" />
                      <XAxis dataKey="distance" stroke="#64748b" tick={{ fontSize: 11 }}
                        label={{ value: 'الموقع على الخط (م)', position: 'insideBottom', offset: -8, fill: '#64748b', fontSize: 11 }} />
                      <YAxis stroke="#64748b" tick={{ fontSize: 11 }}
                        label={{ value: 'الجهد (mV)', angle: -90, position: 'insideLeft', fill: '#64748b', fontSize: 11 }} />
                      <Tooltip contentStyle={{ background: '#1e293b', border: '1px solid #334155', borderRadius: 8 }}
                        labelFormatter={(v) => `الموقع: ${v} م`}
                        formatter={(v: any, name: string) => [`${v} mV`, name === 'natural_potential' ? 'الجهد الطبيعي' : 'القراءة الأولية']} />
                      <Legend formatter={(v) => v === 'natural_potential' ? 'الجهد الطبيعي' : 'القراءة الأولية'} />
                      <ReferenceLine y={-850} stroke="#ef4444" strokeDasharray="6 3" strokeWidth={2}
                        label={{ value: '−850 mV (حد الحماية)', fill: '#ef4444', fontSize: 10, position: 'insideTopRight' }} />
                      <Line type="monotone" dataKey="natural_potential" stroke="#06b6d4" dot={false} strokeWidth={1.5} name="natural_potential" />
                      <Line type="monotone" dataKey="as_found"          stroke="#f59e0b" dot={false} strokeWidth={1.5} name="as_found" />
                    </LineChart>
                  </ResponsiveContainer>
                </div>

                {/* Shift chart */}
                {chartSample.some(p => p.shift_value !== null) && (
                  <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-5">
                    <h3 className="text-base font-semibold text-white mb-1">إزاحة الجهد على طول الخط (mV)</h3>
                    <p className="text-xs text-slate-500 mb-4">الإزاحة الكبيرة تشير إلى تداخل تيارات خارجية أو خلل في نظام الحماية</p>
                    <ResponsiveContainer width="100%" height={200}>
                      <BarChart data={chartSample.filter(p => p.shift_value !== null)} margin={{ top: 5, right: 20, left: 10, bottom: 5 }}>
                        <CartesianGrid strokeDasharray="3 3" stroke="#334155" />
                        <XAxis dataKey="distance" stroke="#64748b" tick={{ fontSize: 10 }}
                          label={{ value: 'الموقع على الخط (م)', position: 'insideBottom', offset: -2, fill: '#64748b', fontSize: 10 }} />
                        <YAxis stroke="#64748b" tick={{ fontSize: 10 }} />
                        <Tooltip contentStyle={{ background: '#1e293b', border: '1px solid #334155', borderRadius: 8 }}
                          labelFormatter={(v) => `الموقع: ${v} م`}
                          formatter={(v: any) => [`${v} mV`, 'الإزاحة']} />
                        <Bar dataKey="shift_value" name="الإزاحة" fill="#8b5cf6" radius={[2, 2, 0, 0]} />
                      </BarChart>
                    </ResponsiveContainer>
                  </div>
                )}

                {/* Fixed segment table */}
                <div className="bg-slate-900/50 rounded-2xl border border-slate-800 overflow-hidden">
                  <div className="px-5 py-4 border-b border-slate-800 flex items-center justify-between">
                    <div>
                      <h3 className="text-base font-semibold text-white">جدول المقاطع الهندسية</h3>
                      <p className="text-xs text-slate-500 mt-0.5">شبكة مقاطع ثابتة بحجم {analysis.segment_size_used} م — مخرجات جاهزة لنظام GIS</p>
                    </div>
                    {onOpenSegments && (
                      <button onClick={onOpenSegments}
                        className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 border border-slate-600 text-xs text-slate-300 transition-colors">
                        <Layers className="w-3.5 h-3.5" /> عرض تفصيلي
                      </button>
                    )}
                  </div>
                  <div className="overflow-x-auto">
                    <table className="w-full text-sm">
                      <thead>
                        <tr className="bg-slate-800/60 text-right">
                          <th className="px-4 py-2.5 text-xs text-slate-400 font-semibold">مقطع الخط</th>
                          <th className="px-4 py-2.5 text-xs text-slate-400 font-semibold">نقاط القياس</th>
                          <th className="px-4 py-2.5 text-xs text-slate-400 font-semibold">متوسط الجهد (mV)</th>
                          <th className="px-4 py-2.5 text-xs text-slate-400 font-semibold">متوسط الإزاحة (mV)</th>
                          <th className="px-4 py-2.5 text-xs text-slate-400 font-semibold">التصنيف</th>
                          <th className="px-4 py-2.5 text-xs text-slate-400 font-semibold">درجة الخطورة</th>
                          <th className="px-4 py-2.5 text-xs text-slate-400 font-semibold">التفسير</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-slate-800/60">
                        {analysis.fixed_segments.map((seg) => {
                          const cfg = segCfg(seg.classification);
                          return (
                            <tr key={seg.seg_id}
                              className={`hover:bg-slate-800/20 ${seg.classification === 'CRITICAL' ? 'bg-red-900/10' : seg.classification === 'WEAK' ? 'bg-amber-900/10' : ''}`}>
                              <td className="px-4 py-2.5 font-mono text-xs text-slate-400">{seg.start_distance}–{seg.end_distance} م</td>
                              <td className="px-4 py-2.5 text-slate-300">{seg.point_count}</td>
                              <td className="px-4 py-2.5 text-slate-300">{seg.avg_potential != null ? seg.avg_potential.toFixed(0) : '—'}</td>
                              <td className="px-4 py-2.5 text-slate-300">{seg.avg_shift != null ? seg.avg_shift.toFixed(1) : '—'}</td>
                              <td className="px-4 py-2.5">
                                <span className={`inline-flex items-center gap-1.5 text-xs font-semibold ${cfg.color}`}>
                                  <span className="w-2 h-2 rounded-full inline-block" style={{ backgroundColor: cfg.dot }} />
                                  {cfg.label}
                                </span>
                              </td>
                              <td className="px-4 py-2.5">
                                <div className="flex items-center gap-1">
                                  {Array.from({ length: 10 }).map((_, j) => (
                                    <div key={j} className={`w-1.5 h-3 rounded-sm ${j < seg.severity_score ? (seg.classification === 'CRITICAL' ? 'bg-red-500' : seg.classification === 'WEAK' ? 'bg-amber-500' : 'bg-emerald-500') : 'bg-slate-700'}`} />
                                  ))}
                                </div>
                              </td>
                              <td className="px-4 py-2.5 text-xs text-slate-400 max-w-48 truncate" title={seg.risk_explanation}>{seg.risk_explanation}</td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                </div>

                {/* Worst segment alert */}
                {analysis.stats.worst_segment && (
                  <div className="bg-red-900/20 rounded-2xl border border-red-500/30 p-5">
                    <div className="flex items-start gap-3">
                      <AlertTriangle className="w-5 h-5 text-red-400 shrink-0 mt-0.5" />
                      <div>
                        <h4 className="font-bold text-red-200 mb-1">أسوأ مقطع بلا حماية</h4>
                        <p className="text-sm text-red-300">
                          من موقع <strong>{analysis.stats.worst_segment.start}</strong> م
                          إلى <strong>{analysis.stats.worst_segment.end}</strong> م
                          — <strong>{analysis.stats.worst_segment.length}</strong> نقطة قياس متتالية بدون حماية كاثودية كافية.
                        </p>
                        <p className="text-xs text-red-400 mt-1">{_CP_RISK_EXPLANATIONS_FRONT.CRITICAL}</p>
                      </div>
                    </div>
                  </div>
                )}
              </>
            )}
          </div>
        ) : null
      )}
    </div>
  );
}

const _CP_RISK_EXPLANATIONS_FRONT = {
  PROTECTED: 'الجهد أقل من −850 mV — حماية كاثودية جيدة وفق معيار NACE SP0169',
  WEAK:      'الجهد بين −700 و −850 mV — حماية غير مستقرة، يُوصى بمراجعة نظام CP',
  CRITICAL:  'الجهد أعلى من −700 mV — لا توجد حماية كاثودية فعالة، خطر تآكل مباشر',
};

// ─── CP Compare Tab Component ─────────────────────────────────────────────────

function CpCompareTab({
  pipelines, pipelinesLoading,
  selectedPipeline, onSelectPipeline,
  segmentSize, onSegmentSizeChange,
  compareSessionA, compareSessionB,
  onCompareSessionAChange, onCompareSessionBChange,
  compareData, compareLoading,
  onRefresh,
}: {
  pipelines: CpPipeline[];
  pipelinesLoading: boolean;
  selectedPipeline: string | null;
  onSelectPipeline: (id: string | null) => void;
  segmentSize: number;
  onSegmentSizeChange: (s: number) => void;
  compareSessionA: string | null;
  compareSessionB: string | null;
  onCompareSessionAChange: (id: string | null) => void;
  onCompareSessionBChange: (id: string | null) => void;
  compareData: CpCompareData | null;
  compareLoading: boolean;
  onRefresh: () => void;
}) {
  const segCfg = (s: string) => CP_STATUS_CONFIG[s as keyof typeof CP_STATUS_CONFIG] ?? CP_STATUS_CONFIG.UNKNOWN;
  const activePipeline = pipelines.find(p =>
    (p.pipeline_id ?? '__UNASSIGNED__') === (selectedPipeline ?? '__UNASSIGNED__')
  ) ?? null;
  const pipelineSessions = activePipeline?.sessions ?? [];

  return (
    <div className="space-y-4">
      {/* ── Control bar ──────────────────────────────────────────────────── */}
      <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-5 space-y-4">
        <div className="flex items-center justify-between flex-wrap gap-3">
          <div>
            <h3 className="text-base font-semibold text-white flex items-center gap-2">
              <BarChart2 className="w-5 h-5 text-purple-400" />
              مقارنة مسحين للحماية الكاثودية
            </h3>
            <p className="text-xs text-slate-500 mt-0.5">اختر نفس الخط وجلستَي مسح مختلفتَين لمعرفة تغيرات مستوى الحماية</p>
          </div>
          <button onClick={onRefresh} disabled={pipelinesLoading}
            className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs text-slate-300 transition-colors disabled:opacity-50">
            <RefreshCw className={`w-3.5 h-3.5 ${pipelinesLoading ? 'animate-spin' : ''}`} /> تحديث
          </button>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
          <div>
            <label className="block text-xs text-slate-400 mb-1">الخط</label>
            {pipelinesLoading ? (
              <div className="h-9 bg-slate-800 rounded-lg animate-pulse" />
            ) : (
              <select
                value={selectedPipeline ?? ''}
                onChange={e => { onSelectPipeline(e.target.value || null); onCompareSessionAChange(null); onCompareSessionBChange(null); }}
                className="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:border-purple-500 focus:outline-none"
              >
                <option value="">— اختر الخط —</option>
                {pipelines.map(p => (
                  <option key={p.pipeline_id ?? '__UNASSIGNED__'} value={p.pipeline_id ?? ''}>
                    {p.display_name} ({p.session_count} جلسة)
                  </option>
                ))}
              </select>
            )}
          </div>
          <div>
            <label className="block text-xs text-slate-400 mb-1">حجم المقطع التحليلي (م)</label>
            <input
              type="number" min={10} max={1000} step={10}
              value={segmentSize}
              onChange={e => onSegmentSizeChange(Math.max(10, Math.min(1000, Number(e.target.value))))}
              className="w-28 bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:border-purple-500 focus:outline-none"
            />
          </div>
        </div>

        {activePipeline && (
          <div className="grid grid-cols-1 md:grid-cols-2 gap-3 pt-3 border-t border-slate-800">
            <div>
              <label className="block text-xs text-slate-400 mb-1">جلسة المسح الأولى (الأقدم — المرجع)</label>
              <select
                value={compareSessionA ?? ''}
                onChange={e => onCompareSessionAChange(e.target.value || null)}
                className="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:border-purple-500 focus:outline-none"
              >
                <option value="">— اختر جلسة المسح —</option>
                {pipelineSessions.map(s => (
                  <option key={s.session_id} value={s.session_id}>
                    {s.survey_date ? `${s.survey_date} — ` : ''}{s.file_name} ({s.total_points} نقطة)
                  </option>
                ))}
              </select>
            </div>
            <div>
              <label className="block text-xs text-slate-400 mb-1">جلسة المسح الثانية (الأحدث — للمقارنة)</label>
              <select
                value={compareSessionB ?? ''}
                onChange={e => onCompareSessionBChange(e.target.value || null)}
                className="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:border-purple-500 focus:outline-none"
              >
                <option value="">— اختر جلسة المسح —</option>
                {pipelineSessions.filter(s => s.session_id !== compareSessionA).map(s => (
                  <option key={s.session_id} value={s.session_id}>
                    {s.survey_date ? `${s.survey_date} — ` : ''}{s.file_name} ({s.total_points} نقطة)
                  </option>
                ))}
              </select>
            </div>
            {!activePipeline.has_multi_survey && (
              <div className="md:col-span-2 bg-amber-900/20 border border-amber-500/30 rounded-xl p-3 text-sm text-amber-300">
                ⚠ هذا الخط يحتوي على جلسة مسح واحدة فقط — المقارنة تتطلب جلستين أو أكثر
              </div>
            )}
          </div>
        )}

        {!selectedPipeline && !pipelinesLoading && (
          <p className="text-xs text-slate-500">اختر الخط أولاً لعرض جلسات المسح المتاحة</p>
        )}
      </div>

      {/* ── Compare output ───────────────────────────────────────────────── */}
      {compareLoading ? (
        <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-10 text-center">
          <RefreshCw className="w-5 h-5 animate-spin inline mr-2 text-purple-400" />
          <span className="text-slate-400">جاري مقارنة الجلستين…</span>
        </div>
      ) : compareData ? (
        <div className="space-y-4">

          {/* Prediction note */}
          <div className={`rounded-xl border p-4 text-sm flex items-center gap-3 ${compareData.prediction_eligible ? 'bg-emerald-900/20 border-emerald-500/30 text-emerald-300' : 'bg-amber-900/20 border-amber-500/30 text-amber-300'}`}>
            <span className="text-xl">{compareData.prediction_eligible ? '✅' : '⚠'}</span>
            <span>{compareData.prediction_note}</span>
          </div>

          {/* Protection loss zones */}
          {compareData.protection_loss_zones.length > 0 && (
            <div className="bg-red-900/20 rounded-2xl border border-red-500/30 p-5">
              <h4 className="font-bold text-red-200 mb-3 flex items-center gap-2">
                <AlertTriangle className="w-4 h-4" />
                مناطق فقدان الحماية ({compareData.protection_loss_zones.length} منطقة)
              </h4>
              <div className="space-y-2">
                {compareData.protection_loss_zones.map((z, i) => (
                  <div key={i} className="flex flex-wrap items-center gap-3 text-sm text-red-300 bg-red-900/20 rounded-lg px-3 py-2">
                    <span className="font-mono font-bold">{z.start_distance}–{z.end_distance} م</span>
                    <span className="text-slate-400">حالة الحماية:</span>
                    <span>{segCfg(z.prev_class).label}</span>
                    <span className="text-slate-600">←</span>
                    <span className={`font-semibold ${segCfg(z.curr_class).color}`}>{segCfg(z.curr_class).label}</span>
                    {z.delta_potential != null && (
                      <span className="text-red-400 font-bold mr-auto">الإزاحة: {z.delta_potential > 0 ? '+' : ''}{z.delta_potential} mV</span>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Combined overlay chart */}
          <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-5">
            <h3 className="text-base font-semibold text-white mb-1">مقارنة الجهد الكهروكيميائي على طول الخط (mV)</h3>
            <p className="text-xs text-slate-500 mb-3">
              <span className="text-cyan-400">الجلسة الأولى ({compareData.session_a.survey_date ?? compareData.session_a.file_name})</span>
              {' '}مقابل{' '}
              <span className="text-emerald-400">الجلسة الثانية ({compareData.session_b.survey_date ?? compareData.session_b.file_name})</span>
            </p>
            <ResponsiveContainer width="100%" height={300}>
              <LineChart
                data={compareData.combined_chart.filter((_, i) => i % Math.ceil(compareData.combined_chart.length / 300) === 0)}
                margin={{ top: 5, right: 20, left: 10, bottom: 15 }}>
                <CartesianGrid strokeDasharray="3 3" stroke="#334155" />
                <XAxis dataKey="distance" stroke="#64748b" tick={{ fontSize: 10 }}
                  label={{ value: 'الموقع على الخط (م)', position: 'insideBottom', offset: -8, fill: '#64748b', fontSize: 11 }} />
                <YAxis stroke="#64748b" tick={{ fontSize: 10 }}
                  label={{ value: 'الجهد (mV)', angle: -90, position: 'insideLeft', fill: '#64748b', fontSize: 11 }} />
                <Tooltip contentStyle={{ background: '#1e293b', border: '1px solid #334155', borderRadius: 8 }}
                  labelFormatter={(v) => `الموقع على الخط: ${v} م`}
                  formatter={(v: any, name: string) => [`${v} mV`, name === 'np_a' ? 'الجلسة الأولى' : 'الجلسة الثانية']} />
                <Legend formatter={(v) => v === 'np_a'
                  ? `الجلسة الأولى (${compareData.session_a.survey_date ?? '—'})`
                  : `الجلسة الثانية (${compareData.session_b.survey_date ?? '—'})`} />
                <ReferenceLine y={-850} stroke="#ef4444" strokeDasharray="6 3" strokeWidth={1.5}
                  label={{ value: '−850 mV (حد الحماية)', fill: '#ef4444', fontSize: 9, position: 'insideTopRight' }} />
                <Line type="monotone" dataKey="np_a" stroke="#06b6d4" dot={false} strokeWidth={1.5} name="np_a" />
                <Line type="monotone" dataKey="np_b" stroke="#34d399" dot={false} strokeWidth={1.5} name="np_b" />
              </LineChart>
            </ResponsiveContainer>
          </div>

          {/* Comparison table */}
          <div className="bg-slate-900/50 rounded-2xl border border-slate-800 overflow-hidden">
            <div className="px-5 py-4 border-b border-slate-800">
              <h3 className="text-base font-semibold text-white">جدول مقارنة المقاطع — {segmentSize} م لكل مقطع</h3>
              <p className="text-xs text-slate-500 mt-0.5">القيم بوحدة mV — الفارق السالب يعني تحسن الحماية</p>
            </div>
            <div className="overflow-x-auto">
              <table className="w-full text-sm">
                <thead>
                  <tr className="bg-slate-800/60 text-right">
                    <th className="px-4 py-2.5 text-xs text-slate-400">مقطع الخط</th>
                    <th className="px-4 py-2.5 text-xs text-slate-400">جلسة أولى (mV)</th>
                    <th className="px-4 py-2.5 text-xs text-slate-400">جلسة ثانية (mV)</th>
                    <th className="px-4 py-2.5 text-xs text-slate-400">الإزاحة (mV)</th>
                    <th className="px-4 py-2.5 text-xs text-slate-400">حالة الحماية — أولى</th>
                    <th className="px-4 py-2.5 text-xs text-slate-400">حالة الحماية — ثانية</th>
                    <th className="px-4 py-2.5 text-xs text-slate-400">التغيير</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-800/60">
                  {compareData.comparison.map((row, i) => {
                    const chg = CHANGE_CONFIG[row.change] ?? { label: row.change, color: 'text-slate-400' };
                    return (
                      <tr key={i} className={`hover:bg-slate-800/20 ${row.change === 'protection_loss' || row.change === 'degraded_to_critical' ? 'bg-red-900/10' : ''}`}>
                        <td className="px-4 py-2.5 font-mono text-xs text-slate-400">{row.start_distance}–{row.end_distance} م</td>
                        <td className="px-4 py-2.5 text-slate-300">{row.session_a_avg_mv != null ? row.session_a_avg_mv.toFixed(0) : '—'}</td>
                        <td className="px-4 py-2.5 text-slate-300">{row.session_b_avg_mv != null ? row.session_b_avg_mv.toFixed(0) : '—'}</td>
                        <td className={`px-4 py-2.5 font-bold ${row.delta_potential_mv != null && row.delta_potential_mv < 0 ? 'text-emerald-400' : row.delta_potential_mv != null && row.delta_potential_mv > 50 ? 'text-red-400' : 'text-slate-300'}`}>
                          {row.delta_potential_mv != null ? `${row.delta_potential_mv > 0 ? '+' : ''}${row.delta_potential_mv.toFixed(0)}` : '—'}
                        </td>
                        <td className={`px-4 py-2.5 text-xs font-semibold ${segCfg(row.session_a_class).color}`}>{segCfg(row.session_a_class).label}</td>
                        <td className={`px-4 py-2.5 text-xs font-semibold ${segCfg(row.session_b_class).color}`}>{segCfg(row.session_b_class).label}</td>
                        <td className={`px-4 py-2.5 text-xs font-semibold ${chg.color}`}>{chg.label}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      ) : (
        <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-12 text-center">
          <BarChart2 className="w-12 h-12 mx-auto mb-3 text-slate-700" />
          <p className="text-slate-400">اختر الخط ثم جلستَي المسح لعرض نتائج المقارنة</p>
          <p className="text-xs text-slate-600 mt-1">المقارنة تتطلب جلستين من نفس الخط في تواريخ مختلفة</p>
        </div>
      )}
    </div>
  );
}


// ─── Segments Tab Component ────────────────────────────────────────────────────

const SEG_ACTION: Record<string, string> = {
  PROTECTED: 'استمرار المراقبة الدورية وفق جدول الصيانة',
  WEAK:      'مراقبة مكثفة — إعادة فحص خلال 90 يوماً ومراجعة نظام التأريض',
  CRITICAL:  'تدخل فوري — مراجعة محولات التيار المطبوع وإعادة التأريض الجزئي',
  UNKNOWN:   'غير محدد — تحقق من اكتمال البيانات',
};

const SEG_RISK_LEVEL: Record<string, { label: string; color: string; bg: string }> = {
  PROTECTED: { label: 'منخفض',  color: 'text-emerald-400', bg: 'bg-emerald-900/20 border-emerald-500/30' },
  WEAK:      { label: 'متوسط',  color: 'text-amber-400',   bg: 'bg-amber-900/20 border-amber-500/30'   },
  CRITICAL:  { label: 'عالٍ',   color: 'text-red-400',     bg: 'bg-red-900/20 border-red-500/30'       },
  UNKNOWN:   { label: 'غير معروف', color: 'text-slate-400', bg: 'bg-slate-800 border-slate-700'        },
};

function SegmentsTab({
  analysis, analysisLoading, viewMode, onGoToAnalysis,
}: {
  analysis: CpAnalysis | null;
  analysisLoading: boolean;
  viewMode: 'specialist' | 'manager';
  onGoToAnalysis: () => void;
}) {
  const segCfg = (s: string) => CP_STATUS_CONFIG[s as keyof typeof CP_STATUS_CONFIG] ?? CP_STATUS_CONFIG.UNKNOWN;

  if (analysisLoading) {
    return (
      <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-12 text-center">
        <RefreshCw className="w-6 h-6 animate-spin inline mr-2 text-cyan-400" />
        <span className="text-slate-400">جاري تحليل المقاطع…</span>
      </div>
    );
  }

  if (!analysis) {
    return (
      <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-12 text-center">
        <Layers className="w-12 h-12 mx-auto mb-3 text-slate-700" />
        <p className="text-slate-400 mb-1">لا توجد مقاطع محلَّلة بعد</p>
        <p className="text-xs text-slate-600 mb-4">افتح تبويب «تحليل المسح» واختر خطًا وجلسة مسح أولاً</p>
        <button onClick={onGoToAnalysis}
          className="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-orange-500/10 hover:bg-orange-500/20 border border-orange-500/30 text-orange-300 text-sm font-medium">
          <Activity className="w-4 h-4" /> الانتقال لتحليل المسح
        </button>
      </div>
    );
  }

  const segs = analysis.fixed_segments;
  const critical = segs.filter(s => s.classification === 'CRITICAL');
  const weak     = segs.filter(s => s.classification === 'WEAK');
  const protected_ = segs.filter(s => s.classification === 'PROTECTED');

  // Manager mode — simplified decision view
  if (viewMode === 'manager') {
    const cfg = OVERALL_STATUS_CONFIG[analysis.overall_status] ?? OVERALL_STATUS_CONFIG.CRITICAL;
    return (
      <div className="space-y-4">
        {/* Status banner */}
        <div className={`rounded-2xl border p-6 ${cfg.bg}`}>
          <div className="flex items-start gap-4">
            <span className="text-4xl">{cfg.icon}</span>
            <div>
              <p className="text-xs text-slate-400 mb-1">ملخص المقاطع — {analysis.session.pipeline_id ?? 'خط غير محدد'}</p>
              <h2 className={`text-2xl font-bold mb-2 ${cfg.text}`}>{cfg.label} — {segs.length} مقطع × {analysis.segment_size_used} م</h2>
              <div className="grid grid-cols-3 gap-3 mt-3">
                <div className="bg-red-900/30 rounded-xl p-3 text-center border border-red-500/30">
                  <p className="text-2xl font-bold text-red-300">{critical.length}</p>
                  <p className="text-xs text-slate-500 mt-0.5">مقطع حرج</p>
                </div>
                <div className="bg-amber-900/30 rounded-xl p-3 text-center border border-amber-500/30">
                  <p className="text-2xl font-bold text-amber-300">{weak.length}</p>
                  <p className="text-xs text-slate-500 mt-0.5">مقطع ضعيف</p>
                </div>
                <div className="bg-emerald-900/30 rounded-xl p-3 text-center border border-emerald-500/30">
                  <p className="text-2xl font-bold text-emerald-300">{protected_.length}</p>
                  <p className="text-xs text-slate-500 mt-0.5">مقطع محمي</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Top critical segments */}
        {critical.length > 0 && (
          <div className="bg-red-900/20 rounded-2xl border border-red-500/30 p-5">
            <h3 className="font-bold text-red-200 mb-3 flex items-center gap-2">
              <AlertTriangle className="w-4 h-4" />
              المقاطع الحرجة التي تستوجب تدخلاً فورياً ({critical.length} مقطع)
            </h3>
            <div className="space-y-2">
              {critical.slice(0, 5).map((seg) => (
                <div key={seg.seg_id} className="flex items-center justify-between bg-red-900/20 rounded-xl px-4 py-3 border border-red-500/20">
                  <div>
                    <p className="text-sm font-bold text-red-200 font-mono">{seg.start_distance} – {seg.end_distance} م</p>
                    <p className="text-xs text-red-400 mt-0.5">متوسط الجهد: {seg.avg_potential != null ? `${seg.avg_potential.toFixed(0)} mV` : '—'}</p>
                  </div>
                  <div className="text-right">
                    <p className="text-xs text-slate-300">{SEG_ACTION[seg.classification]}</p>
                  </div>
                </div>
              ))}
              {critical.length > 5 && <p className="text-xs text-red-400 text-center">+ {critical.length - 5} مقطع آخر</p>}
            </div>
          </div>
        )}

        {/* Overall recommendation */}
        <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-5">
          <div className="flex items-start gap-3">
            <Shield className="w-5 h-5 text-cyan-400 mt-0.5 shrink-0" />
            <div>
              <p className="text-sm font-semibold text-white mb-1">التوصية الهندسية</p>
              <p className="text-sm text-slate-300">{analysis.recommendation}</p>
            </div>
          </div>
        </div>
      </div>
    );
  }

  // Specialist mode — full engineering table
  return (
    <div className="space-y-4">
      {/* Distribution bar */}
      <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-5">
        <div className="flex items-center justify-between flex-wrap gap-2 mb-3">
          <div>
            <h3 className="text-base font-semibold text-white">توزيع حالات الحماية</h3>
            <p className="text-xs text-slate-500 mt-0.5">{segs.length} مقطع × {analysis.segment_size_used} م — خط: {analysis.session.pipeline_id ?? 'غير محدد'} — مسح: {analysis.session.survey_date ?? analysis.session.file_name}</p>
          </div>
          <button onClick={onGoToAnalysis}
            className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 border border-slate-600 text-xs text-slate-300 transition-colors">
            <Activity className="w-3.5 h-3.5" /> العودة للتحليل
          </button>
        </div>

        {/* Stacked bar */}
        <div className="flex h-8 rounded-lg overflow-hidden gap-px">
          {protected_.length > 0 && <div style={{ flex: protected_.length }} className="bg-emerald-600 flex items-center justify-center text-xs font-bold text-white">{protected_.length > 2 ? protected_.length : ''}</div>}
          {weak.length > 0      && <div style={{ flex: weak.length }}      className="bg-amber-500  flex items-center justify-center text-xs font-bold text-white">{weak.length > 2 ? weak.length : ''}</div>}
          {critical.length > 0  && <div style={{ flex: critical.length }}  className="bg-red-600    flex items-center justify-center text-xs font-bold text-white">{critical.length > 2 ? critical.length : ''}</div>}
        </div>

        <div className="flex gap-4 mt-2">
          {[
            { label: `محمية (${protected_.length})`, color: 'bg-emerald-600', text: 'text-emerald-400' },
            { label: `ضعيفة (${weak.length})`,       color: 'bg-amber-500',  text: 'text-amber-400'   },
            { label: `حرجة (${critical.length})`,    color: 'bg-red-600',    text: 'text-red-400'     },
          ].map(item => (
            <span key={item.label} className={`flex items-center gap-1.5 text-xs ${item.text}`}>
              <span className={`w-3 h-3 rounded inline-block ${item.color}`} />
              {item.label}
            </span>
          ))}
        </div>
      </div>

      {/* Full segment table */}
      <div className="bg-slate-900/50 rounded-2xl border border-slate-800 overflow-hidden">
        <div className="px-5 py-4 border-b border-slate-800">
          <h3 className="text-base font-semibold text-white">جدول المقاطع الهندسي التفصيلي</h3>
          <p className="text-xs text-slate-500 mt-0.5">الجهد بوحدة mV — الإزاحة بوحدة mV — النقاط = عدد قياسات CP داخل المقطع</p>
        </div>
        <div className="overflow-x-auto">
          <table className="w-full text-sm">
            <thead>
              <tr className="bg-slate-800/60 text-right">
                {['مقطع الخط','نقاط','الجهد الطبيعي','الإزاحة','حالة الحماية','مستوى الخطر','درجة الخطورة','التوصية الهندسية'].map(h => (
                  <th key={h} className="px-4 py-2.5 text-xs text-slate-400 font-semibold">{h}</th>
                ))}
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-800/60">
              {segs.map((seg) => {
                const cfg   = segCfg(seg.classification);
                const risk  = SEG_RISK_LEVEL[seg.classification] ?? SEG_RISK_LEVEL.UNKNOWN;
                const action = SEG_ACTION[seg.classification] ?? '—';
                return (
                  <tr key={seg.seg_id}
                    className={`hover:bg-slate-800/20 transition-colors ${seg.classification === 'CRITICAL' ? 'bg-red-900/10' : seg.classification === 'WEAK' ? 'bg-amber-900/5' : ''}`}>
                    <td className="px-4 py-3 font-mono text-xs text-slate-300 font-semibold">{seg.start_distance} – {seg.end_distance} م</td>
                    <td className="px-4 py-3 text-slate-400 text-center">{seg.point_count}</td>
                    <td className="px-4 py-3 text-slate-200 font-mono">{seg.avg_potential != null ? `${seg.avg_potential.toFixed(0)}` : '—'}</td>
                    <td className="px-4 py-3 text-slate-400 font-mono">{seg.avg_shift != null ? seg.avg_shift.toFixed(1) : '—'}</td>
                    <td className="px-4 py-3">
                      <span className={`inline-flex items-center gap-1.5 text-xs font-bold ${cfg.color}`}>
                        <span className="w-2 h-2 rounded-full" style={{ backgroundColor: cfg.dot }} />
                        {cfg.label}
                      </span>
                    </td>
                    <td className="px-4 py-3">
                      <span className={`px-2 py-0.5 rounded-lg text-xs font-semibold border ${risk.bg} ${risk.color}`}>{risk.label}</span>
                    </td>
                    <td className="px-4 py-3">
                      <div className="flex items-center gap-0.5">
                        {Array.from({ length: 10 }).map((_, j) => (
                          <div key={j} className={`w-1.5 h-3 rounded-sm ${j < seg.severity_score ? (seg.classification === 'CRITICAL' ? 'bg-red-500' : seg.classification === 'WEAK' ? 'bg-amber-400' : 'bg-emerald-500') : 'bg-slate-700'}`} />
                        ))}
                      </div>
                    </td>
                    <td className="px-4 py-3 text-xs text-slate-400 max-w-52" title={action}>{action}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

      {/* Worst segment alert */}
      {analysis.stats.worst_segment && (
        <div className="bg-red-900/20 rounded-2xl border border-red-500/30 p-5 flex items-start gap-3">
          <AlertTriangle className="w-5 h-5 text-red-400 shrink-0 mt-0.5" />
          <div>
            <h4 className="font-bold text-red-200 mb-1">أسوأ منطقة بلا حماية متتالية</h4>
            <p className="text-sm text-red-300">
              موقع <strong>{analysis.stats.worst_segment.start}</strong> م → <strong>{analysis.stats.worst_segment.end}</strong> م — <strong>{analysis.stats.worst_segment.length}</strong> نقطة قياس متتالية بدون حماية كاثودية كافية
            </p>
            <p className="text-xs text-red-400 mt-1.5">{_CP_RISK_EXPLANATIONS_FRONT.CRITICAL}</p>
          </div>
        </div>
      )}
    </div>
  );
}


// ─── Prediction Tab Component ─────────────────────────────────────────────────

function PredictionTab({
  pipelines, pipelinesLoading,
  selectedPipeline, onSelectPipeline,
  segmentSize, onSegmentSizeChange,
  compareSessionA, compareSessionB,
  onCompareSessionAChange, onCompareSessionBChange,
  compareData, compareLoading,
  viewMode, onGoToSessions, onRefresh,
}: {
  pipelines: CpPipeline[];
  pipelinesLoading: boolean;
  selectedPipeline: string | null;
  onSelectPipeline: (id: string | null) => void;
  segmentSize: number;
  onSegmentSizeChange: (s: number) => void;
  compareSessionA: string | null;
  compareSessionB: string | null;
  onCompareSessionAChange: (id: string | null) => void;
  onCompareSessionBChange: (id: string | null) => void;
  compareData: CpCompareData | null;
  compareLoading: boolean;
  viewMode: 'specialist' | 'manager';
  onGoToSessions: () => void;
  onRefresh: () => void;
}) {
  const eligiblePipelines = pipelines.filter(p => p.has_multi_survey);
  const activePipeline    = pipelines.find(p =>
    (p.pipeline_id ?? '__UNASSIGNED__') === (selectedPipeline ?? '__UNASSIGNED__')
  ) ?? null;
  const pipelineSessions = activePipeline?.sessions ?? [];

  // Insufficient history
  if (!pipelinesLoading && eligiblePipelines.length === 0) {
    return (
      <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-12 text-center space-y-4">
        <TrendingDown className="w-14 h-14 mx-auto text-slate-700" />
        <div>
          <h3 className="text-lg font-semibold text-slate-300 mb-2">التنبؤ يحتاج أكثر من جلسة مسح زمنية لنفس الخط</h3>
          <p className="text-sm text-slate-500 max-w-md mx-auto">
            لتفعيل نظام التنبؤ بالتدهور، يجب أن تتوفر جلستا مسح CP على الأقل لنفس الخط في تواريخ مختلفة.
            كلما زاد عدد الجلسات، ارتفعت دقة التنبؤ.
          </p>
        </div>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-3 max-w-lg mx-auto text-right mt-2">
          {[
            { icon: '📥', label: 'استيراد جلسة ثانية', desc: 'أضف مسحًا CP آخر لنفس الخط بتاريخ مختلف' },
            { icon: '📅', label: 'فاصل زمني مناسب', desc: 'يُوصى بفاصل 6 أشهر على الأقل بين الجلستين' },
            { icon: '📊', label: 'تفعيل التنبؤ', desc: 'يحسب النظام معدل تدهور الحماية تلقائياً' },
          ].map(item => (
            <div key={item.label} className="bg-slate-800/50 rounded-xl border border-slate-700 p-4">
              <p className="text-2xl mb-2">{item.icon}</p>
              <p className="text-sm font-semibold text-slate-300">{item.label}</p>
              <p className="text-xs text-slate-500 mt-1">{item.desc}</p>
            </div>
          ))}
        </div>
        <button onClick={onGoToSessions}
          className="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-orange-500/10 hover:bg-orange-500/20 border border-orange-500/30 text-orange-300 font-medium">
          <Upload className="w-4 h-4" /> استيراد جلسة مسح جديدة
        </button>
      </div>
    );
  }

  return (
    <div className="space-y-4">

      {/* ── Pipeline + session selection ─────────────────────────────────── */}
      <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-5 space-y-4">
        <div className="flex items-center justify-between flex-wrap gap-3">
          <div>
            <h3 className="text-base font-semibold text-white flex items-center gap-2">
              <TrendingDown className="w-5 h-5 text-purple-400" />
              توقع تدهور الحماية الكاثودية
            </h3>
            <p className="text-xs text-slate-500 mt-0.5">يرتكز التنبؤ على معدل تغير الجهد بين الجلستين وتوزيع المقاطع الحرجة</p>
          </div>
          <button onClick={onRefresh} disabled={pipelinesLoading}
            className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs text-slate-300 disabled:opacity-50">
            <RefreshCw className={`w-3.5 h-3.5 ${pipelinesLoading ? 'animate-spin' : ''}`} /> تحديث
          </button>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
          <div>
            <label className="block text-xs text-slate-400 mb-1">الخط (مؤهل للتنبؤ)</label>
            <select
              value={selectedPipeline ?? ''}
              onChange={e => { onSelectPipeline(e.target.value || null); onCompareSessionAChange(null); onCompareSessionBChange(null); }}
              className="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:border-purple-500 focus:outline-none"
            >
              <option value="">— اختر الخط —</option>
              {eligiblePipelines.map(p => (
                <option key={p.pipeline_id ?? '__UNASSIGNED__'} value={p.pipeline_id ?? ''}>
                  {p.display_name} ({p.session_count} جلسات)
                </option>
              ))}
            </select>
          </div>
          <div>
            <label className="block text-xs text-slate-400 mb-1">جلسة المرجع الأساسي (الأقدم)</label>
            <select value={compareSessionA ?? ''} onChange={e => onCompareSessionAChange(e.target.value || null)}
              disabled={!activePipeline}
              className="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:border-purple-500 focus:outline-none disabled:opacity-50">
              <option value="">— اختر الجلسة —</option>
              {pipelineSessions.map(s => (
                <option key={s.session_id} value={s.session_id}>
                  {s.survey_date ?? s.file_name.slice(0, 30)} ({s.total_points} نقطة)
                </option>
              ))}
            </select>
          </div>
          <div>
            <label className="block text-xs text-slate-400 mb-1">جلسة المرجع المحدَّث (الأحدث)</label>
            <select value={compareSessionB ?? ''} onChange={e => onCompareSessionBChange(e.target.value || null)}
              disabled={!activePipeline}
              className="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:border-purple-500 focus:outline-none disabled:opacity-50">
              <option value="">— اختر الجلسة —</option>
              {pipelineSessions.filter(s => s.session_id !== compareSessionA).map(s => (
                <option key={s.session_id} value={s.session_id}>
                  {s.survey_date ?? s.file_name.slice(0, 30)} ({s.total_points} نقطة)
                </option>
              ))}
            </select>
          </div>
        </div>
      </div>

      {/* ── Prediction output ────────────────────────────────────────────── */}
      {compareLoading ? (
        <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-10 text-center">
          <RefreshCw className="w-5 h-5 animate-spin inline mr-2 text-purple-400" />
          <span className="text-slate-400">جاري حساب معدل التدهور…</span>
        </div>
      ) : compareData ? (
        <div className="space-y-4">

          {/* Eligibility banner */}
          <div className={`rounded-xl border p-4 flex items-center gap-3 ${compareData.prediction_eligible ? 'bg-emerald-900/20 border-emerald-500/30 text-emerald-300' : 'bg-amber-900/20 border-amber-500/30 text-amber-300'}`}>
            <span className="text-2xl">{compareData.prediction_eligible ? '✅' : '⚠'}</span>
            <div>
              <p className="font-semibold text-sm">{compareData.prediction_eligible ? 'البيانات كافية للتنبؤ' : 'البيانات غير كافية للتنبؤ الدقيق'}</p>
              <p className="text-xs opacity-80 mt-0.5">{compareData.prediction_note}</p>
            </div>
          </div>

          {(() => {
            // Calculate linear deterioration rate from compare data
            const comp = compareData.comparison;
            const avgDelta = comp.length > 0
              ? comp.reduce((s, r) => s + (r.delta_potential_mv ?? 0), 0) / comp.length
              : 0;
            const lossCount    = comp.filter(r => r.change === 'protection_loss' || r.change === 'degraded_to_critical').length;
            const improveCount = comp.filter(r => r.change === 'improved').length;
            const sessionADate = compareData.session_a.survey_date;
            const sessionBDate = compareData.session_b.survey_date;

            return (
              <>
                {/* Trend KPIs */}
                <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
                  {[
                    { label: 'متوسط إزاحة الجهد', value: `${avgDelta > 0 ? '+' : ''}${avgDelta.toFixed(1)} mV`, color: avgDelta > 50 ? 'text-red-400' : avgDelta > 0 ? 'text-amber-400' : 'text-emerald-400', icon: '📉', desc: 'بين الجلستين' },
                    { label: 'مقاطع فاقدة حمايتها', value: lossCount, color: lossCount > 0 ? 'text-red-400' : 'text-emerald-400', icon: '⚠', desc: 'في الفترة الزمنية' },
                    { label: 'مقاطع تحسنت', value: improveCount, color: 'text-emerald-400', icon: '✅', desc: 'في الفترة الزمنية' },
                    { label: 'الفاصل الزمني', value: (sessionADate && sessionBDate) ? `${sessionADate.slice(0,7)} → ${sessionBDate.slice(0,7)}` : 'غير محدد', color: 'text-slate-300', icon: '📅', desc: 'بين الجلستين' },
                  ].map((kpi, i) => (
                    <div key={i} className="bg-slate-900/50 rounded-xl border border-slate-800 p-4">
                      <div className="flex items-center gap-2 mb-1"><span>{kpi.icon}</span><p className="text-xs text-slate-500">{kpi.label}</p></div>
                      <p className={`text-xl font-bold ${kpi.color}`}>{kpi.value}</p>
                      <p className="text-xs text-slate-600 mt-0.5">{kpi.desc}</p>
                    </div>
                  ))}
                </div>

                {/* Specialist: overlay trend chart */}
                {viewMode === 'specialist' && (
                  <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-5">
                    <h3 className="text-base font-semibold text-white mb-1">مقارنة مسار الجهد بين الجلستين</h3>
                    <p className="text-xs text-slate-500 mb-1">
                      <span className="text-cyan-400">الجلسة المرجعية ({compareData.session_a.survey_date ?? '—'})</span>
                      {' '}مقابل{' '}
                      <span className="text-purple-400">الجلسة المحدَّثة ({compareData.session_b.survey_date ?? '—'})</span>
                    </p>
                    <p className="text-xs text-slate-600 mb-3">المنطقة بين المنحنيين = حجم التدهور — توسعها يعني تسارع فقدان الحماية</p>
                    <ResponsiveContainer width="100%" height={280}>
                      <AreaChart
                        data={compareData.combined_chart.filter((_, i) => i % Math.ceil(compareData.combined_chart.length / 300) === 0)}
                        margin={{ top: 5, right: 20, left: 10, bottom: 15 }}>
                        <CartesianGrid strokeDasharray="3 3" stroke="#334155" />
                        <XAxis dataKey="distance" stroke="#64748b" tick={{ fontSize: 10 }}
                          label={{ value: 'الموقع على الخط (م)', position: 'insideBottom', offset: -8, fill: '#64748b', fontSize: 10 }} />
                        <YAxis stroke="#64748b" tick={{ fontSize: 10 }}
                          label={{ value: 'الجهد (mV)', angle: -90, position: 'insideLeft', fill: '#64748b', fontSize: 10 }} />
                        <Tooltip contentStyle={{ background: '#1e293b', border: '1px solid #334155', borderRadius: 8 }}
                          labelFormatter={v => `الموقع: ${v} م`}
                          formatter={(v: any, name: string) => [`${v} mV`, name === 'np_a' ? 'المرجع الأقدم' : 'المحدَّث الأحدث']} />
                        <ReferenceLine y={-850} stroke="#ef4444" strokeDasharray="5 3" strokeWidth={1.5}
                          label={{ value: '−850 mV', fill: '#ef4444', fontSize: 9 }} />
                        <Area type="monotone" dataKey="np_a" stroke="#06b6d4" fill="#06b6d4" fillOpacity={0.08} dot={false} strokeWidth={1.5} name="np_a" />
                        <Area type="monotone" dataKey="np_b" stroke="#a855f7" fill="#a855f7" fillOpacity={0.12} dot={false} strokeWidth={1.5} name="np_b" />
                      </AreaChart>
                    </ResponsiveContainer>
                  </div>
                )}

                {/* Forecast cards */}
                {compareData.prediction_eligible && (
                  <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-5">
                    <h3 className="text-base font-semibold text-white mb-1">توقع التدهور المستقبلي</h3>
                    <p className="text-xs text-amber-400 mb-4 flex items-center gap-1">
                      <Info className="w-3.5 h-3.5" />
                      تقدير استرشادي مبني على معدل التغيير الملاحَظ — ليس ضماناً هندسياً
                    </p>
                    <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
                      {[
                        { period: '6 أشهر', multiplier: 0.5, urgency: 'مراقبة', color: 'border-amber-500/30 bg-amber-900/20', textColor: 'text-amber-300' },
                        { period: '12 شهراً', multiplier: 1,   urgency: 'تدخل دوري', color: 'border-orange-500/30 bg-orange-900/20', textColor: 'text-orange-300' },
                        { period: '24 شهراً', multiplier: 2,   urgency: 'تدخل ضروري', color: 'border-red-500/30 bg-red-900/20',    textColor: 'text-red-300' },
                      ].map(({ period, multiplier, urgency, color, textColor }) => {
                        const projectedDelta = avgDelta * multiplier;
                        const projectedLoss  = Math.min(100, Math.round(lossCount * multiplier));
                        return (
                          <div key={period} className={`rounded-2xl border p-4 ${color}`}>
                            <p className={`text-lg font-bold ${textColor}`}>{period}</p>
                            <div className="space-y-1 mt-2 text-xs text-slate-300">
                              <p>الإزاحة المتوقعة: <span className={`font-bold ${textColor}`}>{projectedDelta > 0 ? '+' : ''}{projectedDelta.toFixed(0)} mV</span></p>
                              <p>مقاطع مهددة: <span className="font-bold">{projectedLoss}</span></p>
                              <p>الإجراء المقترح: <span className={`font-bold ${textColor}`}>{urgency}</span></p>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                )}
              </>
            );
          })()}
        </div>
      ) : (
        <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-10 text-center">
          <TrendingDown className="w-10 h-10 mx-auto mb-3 text-slate-700" />
          <p className="text-slate-400">اختر الخط وجلستَي المسح لحساب معدل التدهور والتنبؤ المستقبلي</p>
        </div>
      )}
    </div>
  );
}


// ─── Scenarios Tab Component ──────────────────────────────────────────────────

const SCENARIOS = [
  {
    id: 'delay',
    icon: '⏳',
    title: 'تأجيل الصيانة 6 أشهر',
    color: 'border-amber-500/30 bg-amber-900/15',
    headerColor: 'text-amber-300',
    technical:    'احتمالية توسع المقاطع الضعيفة إلى معدل خطر أعلى بنسبة 25–40%',
    risk:         'ارتفاع منطقي في احتمالية الكسر الجزئي للغلاف الواقي في المناطق الحرجة',
    operational:  'لا توقف متوقع على المدى القصير — المراقبة الأسبوعية كافية',
    budget:       'توفير مؤقت في التكاليف — لكن مخاطر تصعيد التكلفة في الفترة 7–12 شهر',
    recommended:  false,
  },
  {
    id: 'partial',
    icon: '🔧',
    title: 'معالجة أسوأ المقاطع فقط',
    color: 'border-blue-500/30 bg-blue-900/15',
    headerColor: 'text-blue-300',
    technical:    'استهداف المقاطع ذات أدنى جهد وأعلى درجة خطورة — تحسين 65–75% من مناطق الخطر',
    risk:         'تخفيض فوري للمخاطر في النقاط الحرجة — المقاطع المتوسطة تظل تحت المراقبة',
    operational:  'تعطل جزئي خلال فترة العمل على المقاطع المستهدفة فقط',
    budget:       'تكلفة متوسطة — توزيع ذكي للموارد مع نتائج موثوقة',
    recommended:  true,
  },
  {
    id: 'full',
    icon: '🚨',
    title: 'تدخل طارئ شامل',
    color: 'border-red-500/30 bg-red-900/15',
    headerColor: 'text-red-300',
    technical:    'إعادة تأهيل كاملة لنظام CP على طول الخط — فحص شامل لمحولات التيار المطبوع',
    risk:         'أقصى تخفيض للمخاطر — إعادة الخط إلى مستوى الحماية الكاملة',
    operational:  'إيقاف مؤقت للخط أو تشغيل محدود خلال فترة التدخل',
    budget:       'أعلى تكلفة مباشرة — لكن أدنى تكلفة كلية على المدى البعيد',
    recommended:  false,
  },
];

function ScenariosTab({
  analysis, pipelines, viewMode, onGoToAnalysis,
}: {
  analysis: CpAnalysis | null;
  pipelines: CpPipeline[];
  viewMode: 'specialist' | 'manager';
  onGoToAnalysis: () => void;
}) {
  const [activeScenario, setActiveScenario] = React.useState<string | null>(null);

  return (
    <div className="space-y-4">

      {/* Header */}
      <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-5">
        <div className="flex items-center justify-between flex-wrap gap-3">
          <div>
            <h3 className="text-base font-semibold text-white flex items-center gap-2">
              <Sparkles className="w-5 h-5 text-purple-400" />
              السيناريوهات الهندسية — تحليل ماذا لو
            </h3>
            <p className="text-xs text-slate-500 mt-0.5">
              قارن تأثير قرارات الصيانة المختلفة على المستوى التقني والمخاطر والتشغيل والميزانية
            </p>
          </div>
          {!analysis && (
            <button onClick={onGoToAnalysis}
              className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 border border-slate-600 text-xs text-slate-300">
              <Activity className="w-3.5 h-3.5" /> حمِّل بيانات التحليل أولاً
            </button>
          )}
        </div>

        {/* Context info if analysis loaded */}
        {analysis && (
          <div className="mt-3 flex flex-wrap gap-3">
            <span className="px-2.5 py-1 rounded-lg bg-slate-800/60 border border-slate-700 text-xs text-slate-300">
              الخط: {analysis.session.pipeline_id ?? 'غير محدد'}
            </span>
            <span className="px-2.5 py-1 rounded-lg bg-slate-800/60 border border-slate-700 text-xs text-cyan-300">
              {analysis.stats.total_points.toLocaleString()} نقطة قياس
            </span>
            <span className={`px-2.5 py-1 rounded-lg text-xs font-semibold border ${
              analysis.overall_status === 'CRITICAL' ? 'bg-red-900/30 border-red-500/30 text-red-300' :
              analysis.overall_status === 'WARNING'  ? 'bg-amber-900/30 border-amber-500/30 text-amber-300' :
              'bg-emerald-900/30 border-emerald-500/30 text-emerald-300'
            }`}>
              الوضع الحالي: {OVERALL_STATUS_CONFIG[analysis.overall_status]?.label ?? '—'}
            </span>
          </div>
        )}
      </div>

      {/* Scenario cards */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        {SCENARIOS.map((s) => (
          <button key={s.id}
            onClick={() => setActiveScenario(activeScenario === s.id ? null : s.id)}
            className={`text-right rounded-2xl border p-5 transition-all hover:brightness-110 ${s.color} ${activeScenario === s.id ? 'ring-2 ring-white/20' : ''}`}>
            <div className="flex items-start justify-between mb-3">
              <div>
                <p className="text-2xl">{s.icon}</p>
                <h4 className={`text-base font-bold mt-1 ${s.headerColor}`}>{s.title}</h4>
              </div>
              {s.recommended && (
                <span className="px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-900/40 border border-emerald-500/40 text-emerald-300">موصى به</span>
              )}
            </div>
            <p className="text-xs text-slate-400 line-clamp-2">{s.technical}</p>
            <p className="text-xs text-slate-500 mt-1">{activeScenario === s.id ? 'اضغط للطي' : 'اضغط للتفاصيل'}</p>
          </button>
        ))}
      </div>

      {/* Expanded scenario detail */}
      {activeScenario && (() => {
        const s = SCENARIOS.find(sc => sc.id === activeScenario)!;
        return (
          <div className={`rounded-2xl border p-6 ${s.color} space-y-4`}>
            <h3 className={`text-xl font-bold ${s.headerColor} flex items-center gap-2`}>
              <span>{s.icon}</span> {s.title}
            </h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {[
                { label: '⚙ التأثير التقني', value: s.technical,   icon: 'text-cyan-400'   },
                { label: '🛡 تأثير المخاطر',   value: s.risk,        icon: 'text-orange-400' },
                { label: '🏭 التأثير التشغيلي', value: s.operational, icon: 'text-blue-400'   },
                { label: '💰 التأثير المالي',   value: s.budget,      icon: 'text-purple-400' },
              ].map(item => (
                <div key={item.label} className="bg-black/20 rounded-xl p-4">
                  <p className={`text-xs font-bold mb-2 ${item.icon}`}>{item.label}</p>
                  <p className="text-sm text-slate-200">{item.value}</p>
                  {analysis && item.label.includes('تقني') && (
                    <p className="text-xs text-slate-500 mt-2">
                      بناءً على {analysis.stats.critical_zones} منطقة حرجة و{analysis.stats.critical_count} نقطة بدون حماية
                    </p>
                  )}
                </div>
              ))}
            </div>
            {s.recommended && (
              <div className="flex items-center gap-3 bg-emerald-900/30 rounded-xl border border-emerald-500/30 px-4 py-3">
                <CheckCircle className="w-5 h-5 text-emerald-400 shrink-0" />
                <p className="text-sm text-emerald-300">هذا السيناريو هو التوازن الأمثل — يحقق أفضل نسبة تخفيض خطر مقابل تكلفة التدخل</p>
              </div>
            )}
          </div>
        );
      })()}

      {/* Manager mode: simple decision matrix */}
      {viewMode === 'manager' && (
        <div className="bg-slate-900/50 rounded-2xl border border-slate-800 overflow-hidden">
          <div className="px-5 py-4 border-b border-slate-800">
            <h3 className="text-sm font-semibold text-white">مقارنة السيناريوهات دفعةً واحدة</h3>
          </div>
          <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead>
                <tr className="bg-slate-800/40 text-right">
                  {['القرار', 'تخفيض الخطر', 'التكلفة', 'تأثير التشغيل', 'التوصية'].map(h => (
                    <th key={h} className="px-4 py-2.5 text-xs text-slate-400 font-semibold">{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-800/60">
                {[
                  { label: 'تأجيل الصيانة',      risk: 'منخفض ↓20%',   cost: 'صفر',     ops: 'بدون توقف',     rec: '—' },
                  { label: 'معالجة أسوأ المقاطع', risk: 'عالٍ ↓70%',   cost: 'متوسطة',  ops: 'توقف جزئي',     rec: 'موصى به ✓' },
                  { label: 'تدخل طارئ شامل',      risk: 'كامل ↓95%+',  cost: 'عالية',   ops: 'إيقاف مؤقت',    rec: 'إن تعذّر الأول' },
                ].map((row, i) => (
                  <tr key={i} className="hover:bg-slate-800/20">
                    <td className="px-4 py-3 text-slate-200 font-medium">{row.label}</td>
                    <td className="px-4 py-3 text-slate-300">{row.risk}</td>
                    <td className="px-4 py-3 text-slate-300">{row.cost}</td>
                    <td className="px-4 py-3 text-slate-300">{row.ops}</td>
                    <td className="px-4 py-3"><span className={`text-xs font-bold ${row.rec.includes('✓') ? 'text-emerald-400' : 'text-slate-500'}`}>{row.rec}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </div>
  );
}


// ─── Upload Panel Component ───────────────────────────────────────────────────

function UploadPanel({ onSuccess }: { onSuccess: () => void }) {
  type PanelState = 'idle' | 'previewing' | 'cp_preview' | 'uploading' | 'mapping' | 'success' | 'error';
  const [state, setState] = useState<PanelState>('idle');
  const [result, setResult] = useState<any>(null);
  const [dragOver, setDragOver] = useState(false);
  const [pendingFile, setPendingFile] = useState<File | null>(null);
  const [cpPreview, setCpPreview] = useState<any>(null);
  const [mappingData, setMappingData] = useState<any>(null);
  const [userMapping, setUserMapping] = useState<Record<string, string>>({});
  const [pipelineInput, setPipelineInput] = useState('');
  const [surveyDateInput, setSurveyDateInput] = useState('');
  const fileRef = useRef<HTMLInputElement>(null);

  const REQUIRED_LABELS: Record<string, string> = {
    asset_id: 'معرّف الأصل',
    degradation_type_code: 'نوع التدهور',
    measurement_value: 'القيمة',
    measurement_timestamp: 'التاريخ',
  };

  // ── Step 1: Preview (auto-detect file type) ────────────────────────────────
  const doPreview = async (file: File) => {
    setState('previewing');
    setResult(null);
    const form = new FormData();
    form.append('file', file);
    if (pipelineInput.trim()) form.append('pipeline_id', pipelineInput.trim());
    try {
      const r = await fetch('/api/v1/corrosion/cp-preview', { method: 'POST', body: form });
      const data = await r.json();
      if (data.is_cp_survey) {
        // High-confidence CP Survey detected — show preview panel
        setCpPreview(data);
        setPendingFile(file);
        setState('cp_preview');
      } else {
        // Not CP survey — go directly to generic upload
        await doUpload(file);
      }
    } catch {
      // Preview failed — fall through to generic upload
      await doUpload(file);
    }
  };

  // ── Step 2a: Confirm CP Survey import ──────────────────────────────────────
  const confirmCpImport = async () => {
    if (!pendingFile) return;
    setState('uploading');
    const form = new FormData();
    form.append('file', pendingFile);
    form.append('force_cp', 'true');
    if (pipelineInput.trim()) form.append('pipeline_id', pipelineInput.trim());
    const surveyDate = surveyDateInput.trim() || cpPreview?.survey_date;
    if (surveyDate) form.append('survey_date', surveyDate);
    try {
      const r = await fetch('/api/v1/corrosion/upload', { method: 'POST', body: form });
      const data = await r.json();
      if (r.ok) {
        setState('success');
        setResult(data);
        setPendingFile(null);
        setCpPreview(null);
        setSurveyDateInput('');
        onSuccess();
      } else {
        setState('error');
        setResult(data.detail ?? data);
      }
    } catch (e: any) {
      setState('error');
      setResult({ message: e.message });
    }
  };

  // ── Step 2b: Generic upload (non-CP or manual override) ───────────────────
  const doUpload = async (file: File, mapping?: Record<string, string>) => {
    setState('uploading');
    setResult(null);
    const form = new FormData();
    form.append('file', file);
    if (pipelineInput.trim()) form.append('pipeline_id', pipelineInput.trim());
    if (mapping && Object.keys(mapping).length > 0) {
      form.append('user_mapping', JSON.stringify(mapping));
    }
    try {
      const r = await fetch('/api/v1/corrosion/upload', { method: 'POST', body: form });
      const data = await r.json();
      if (r.ok) {
        setState('success');
        setResult(data);
        setPendingFile(null);
        setMappingData(null);
        setUserMapping({});
        onSuccess();
      } else if (r.status === 422 && data?.detail?.status === 'mapping_required') {
        setState('mapping');
        setMappingData(data.detail);
        setPendingFile(file);
        setUserMapping(data.detail.auto_mapped ?? {});
      } else if (r.status === 422 && data?.detail?.status === 'unsupported_format') {
        setState('error');
        setResult(data.detail);
      } else {
        setState('error');
        setResult(data.detail ?? data);
      }
    } catch (e: any) {
      setState('error');
      setResult({ message: e.message });
    }
  };

  const handleFile = (file: File) => doPreview(file);

  const confirmMapping = () => {
    if (!pendingFile) return;
    const missing = Object.keys(REQUIRED_LABELS).filter(k => !userMapping[k]);
    if (missing.length > 0) return;
    doUpload(pendingFile, userMapping);
  };

  const isActive = state === 'uploading' || state === 'previewing';

  return (
    <div className="space-y-4">

      {/* ── Session metadata inputs ──────────────────────────────────────── */}
      <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-4">
        <h3 className="text-sm font-semibold text-slate-300 mb-3">بيانات جلسة المسح — اختياري</h3>
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label className="block text-xs text-slate-400 mb-1">معرف الخط (Pipeline ID)</label>
            <input
              type="text"
              value={pipelineInput}
              onChange={e => setPipelineInput(e.target.value)}
              placeholder="مثال: CENTRAL-01"
              className="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-orange-500 transition-colors"
              disabled={isActive}
            />
          </div>
          <div>
            <label className="block text-xs text-slate-400 mb-1">تاريخ المسح (يتجاوز الكشف التلقائي)</label>
            <input
              type="date"
              value={surveyDateInput}
              onChange={e => setSurveyDateInput(e.target.value)}
              className="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-orange-500 transition-colors"
              disabled={isActive}
            />
          </div>
        </div>
        <p className="text-xs text-slate-500 mt-2">هذه البيانات اختيارية — يكتشف النظام تاريخ المسح تلقائياً من بيانات الملف</p>
      </div>

      {/* ── Drop zone — hide during CP preview / mapping / uploading ─────── */}
      {state !== 'mapping' && state !== 'cp_preview' && (
        <div
          onDragOver={e => { e.preventDefault(); setDragOver(true); }}
          onDragLeave={() => setDragOver(false)}
          onDrop={e => {
            e.preventDefault();
            setDragOver(false);
            const file = e.dataTransfer.files?.[0];
            if (file) handleFile(file);
          }}
          onClick={() => !isActive && fileRef.current?.click()}
          className={`relative border-2 border-dashed rounded-2xl p-12 text-center cursor-pointer transition-all ${
            dragOver
              ? 'border-orange-400 bg-orange-500/10'
              : 'border-slate-700 bg-slate-900/50 hover:border-orange-500/50 hover:bg-orange-500/5'
          }`}
        >
          <input
            ref={fileRef}
            type="file"
            accept=".csv,.xls,.xlsx"
            className="hidden"
            onChange={e => { const f = e.target.files?.[0]; if (f) handleFile(f); }}
          />
          {(state === 'uploading' || state === 'previewing') ? (
            <div className="flex flex-col items-center gap-3">
              <RefreshCw className="w-12 h-12 text-orange-400 animate-spin" />
              <p className="text-lg text-slate-300">
                {state === 'previewing' ? 'جاري تحليل نوع الملف…' : 'جاري إدخال البيانات…'}
              </p>
            </div>
          ) : (
            <div className="flex flex-col items-center gap-3">
              <Upload className="w-12 h-12 text-slate-600" />
              <p className="text-lg font-semibold text-slate-300">اسحب الملف هنا أو انقر للتصفح</p>
              <p className="text-sm text-slate-500">يقبل CSV / XLS / XLSX</p>
            </div>
          )}
        </div>
      )}

      {/* ── CP Survey Auto-Detection Panel ───────────────────────────────── */}
      {state === 'cp_preview' && cpPreview && (
        <div className="bg-gradient-to-br from-blue-950/40 to-slate-900/60 border border-blue-500/40 rounded-2xl p-6 space-y-5">
          {/* Header */}
          <div className="flex items-start gap-4">
            <div className="p-3 rounded-xl bg-blue-500/20 border border-blue-500/30 shrink-0">
              <Activity className="w-7 h-7 text-blue-400" />
            </div>
            <div>
              <div className="flex items-center gap-2 mb-1">
                <h3 className="text-lg font-bold text-blue-200">تم التعرف على ملف مسح CP</h3>
                <span className="px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-900/40 border border-emerald-500/40 text-emerald-300">
                  ثقة {Math.round(cpPreview.confidence * 100)}%
                </span>
              </div>
              <p className="text-sm text-blue-300/70">{cpPreview.filename}</p>
            </div>
          </div>

          {/* Detection Summary Grid */}
          <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
            {[
              { label: 'نقاط المسح', value: cpPreview.total_points, icon: <Activity className="w-4 h-4 text-blue-400" /> },
              { label: 'نطاق المسافة', value: cpPreview.start_distance != null ? `${cpPreview.start_distance} → ${cpPreview.end_distance} م` : '—', icon: <TrendingDown className="w-4 h-4 text-orange-400" /> },
              { label: 'تاريخ المسح', value: cpPreview.survey_date ?? '—', icon: <Calendar className="w-4 h-4 text-emerald-400" /> },
              { label: 'صف الرأسية', value: cpPreview.detected_header_row != null ? `صف ${cpPreview.detected_header_row + 1}` : '—', icon: <FileText className="w-4 h-4 text-slate-400" /> },
            ].map(s => (
              <div key={s.label} className="bg-slate-800/60 rounded-xl border border-slate-700 p-3">
                <div className="flex items-center gap-1.5 mb-1">{s.icon}<p className="text-xs text-slate-500">{s.label}</p></div>
                <p className="text-sm font-bold text-white">{s.value}</p>
              </div>
            ))}
          </div>

          {/* Detected Series */}
          <div>
            <p className="text-xs font-semibold text-slate-400 mb-2">السلاسل المكتشفة تلقائياً:</p>
            <div className="flex flex-wrap gap-2">
              {cpPreview.detected_fields.map((f: string) => {
                const FIELD_AR: Record<string,string> = {
                  distance: 'المسافة', natural_potential: 'الجهد الطبيعي',
                  as_found: 'As-Found', as_left: 'As-Left', shift: 'الإزاحة',
                  on_potential: 'ON', off_potential: 'OFF', instant_off: 'Inst-Off',
                  pipe_to_soil: 'Pipe-to-Soil', time: 'الوقت', status: 'الحالة', code: 'الكود'
                };
                return (
                  <span key={f} className="flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-blue-900/40 border border-blue-500/40 text-blue-300">
                    <CheckCircle className="w-3 h-3" />
                    {FIELD_AR[f] ?? f}
                  </span>
                );
              })}
            </div>
          </div>

          {/* Sheets info */}
          {(cpPreview.sheets_processed?.length > 0 || cpPreview.sheets_skipped?.length > 0) && (
            <div className="flex flex-wrap gap-2 text-xs">
              {cpPreview.sheets_processed?.map((s: string) => (
                <span key={s} className="px-2 py-0.5 rounded-md bg-emerald-900/30 border border-emerald-700/40 text-emerald-400">ورقة مُعالَجة: {s}</span>
              ))}
              {cpPreview.sheets_skipped?.map((s: string) => (
                <span key={s} className="px-2 py-0.5 rounded-md bg-slate-700/60 border border-slate-600 text-slate-500">متخطاة: {s}</span>
              ))}
            </div>
          )}

          {/* Sample Points Preview */}
          {cpPreview.sample_points?.filter((p: any) => p.distance != null).length > 0 && (
            <div>
              <p className="text-xs font-semibold text-slate-400 mb-2">معاينة أول {cpPreview.sample_points.length} نقاط:</p>
              <div className="overflow-x-auto rounded-xl border border-slate-700">
                <table className="w-full text-xs">
                  <thead>
                    <tr className="bg-slate-800/60 text-slate-400">
                      <th className="px-3 py-2 text-right">المسافة (م)</th>
                      <th className="px-3 py-2 text-right">الجهد الطبيعي (mV)</th>
                      <th className="px-3 py-2 text-right">As-Found (mV)</th>
                    </tr>
                  </thead>
                  <tbody>
                    {cpPreview.sample_points.map((p: any, i: number) => (
                      <tr key={i} className="border-t border-slate-800/50">
                        <td className="px-3 py-1.5 text-slate-300 font-mono">{p.distance ?? '—'}</td>
                        <td className="px-3 py-1.5 text-blue-300 font-mono">{p.natural_potential ?? '—'}</td>
                        <td className="px-3 py-1.5 text-orange-300 font-mono">{p.as_found ?? '—'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {/* Action buttons */}
          <div className="flex gap-3 pt-1">
            <button
              onClick={confirmCpImport}
              className="flex-1 flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl px-5 py-3 text-sm transition-colors shadow-lg shadow-blue-900/40"
            >
              <CheckCircle className="w-4 h-4" />
              تأكيد الاستيراد التلقائي
            </button>
            <button
              onClick={() => { setState('idle'); setCpPreview(null); setPendingFile(null); }}
              className="bg-slate-700 hover:bg-slate-600 text-slate-300 rounded-xl px-4 py-3 text-sm transition-colors"
            >
              إلغاء
            </button>
            <button
              onClick={() => { if (pendingFile) doUpload(pendingFile); setCpPreview(null); }}
              className="bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-slate-200 rounded-xl px-4 py-3 text-sm transition-colors border border-slate-700"
              title="تجاهل الكشف التلقائي واستخدام ربط الأعمدة يدوياً"
            >
              ربط يدوي
            </button>
          </div>
        </div>
      )}

      {/* ── Column mapping UI (mapping_required fallback) ─────────────── */}
      {state === 'mapping' && mappingData && (
        <div className="bg-amber-900/20 border border-amber-500/40 rounded-2xl p-5 space-y-4">
          <div className="flex items-center gap-3 mb-1">
            <AlertTriangle className="w-6 h-6 text-amber-400 shrink-0" />
            <div>
              <h3 className="text-base font-bold text-amber-300">يلزم ربط الأعمدة يدوياً</h3>
              <p className="text-xs text-amber-400/70">لم يتعرف النظام تلقائياً على بعض الأعمدة — حدد التطابق من القائمة</p>
            </div>
          </div>

          {/* Auto-mapped preview */}
          {Object.keys(mappingData.auto_mapped ?? {}).length > 0 && (
            <div className="bg-emerald-900/20 border border-emerald-700/40 rounded-xl px-3 py-2 text-xs">
              <p className="text-emerald-400 font-semibold mb-1">تم ربطها تلقائياً:</p>
              <div className="flex flex-wrap gap-2">
                {Object.entries(mappingData.auto_mapped).map(([can, actual]) => (
                  <span key={can} className="bg-emerald-900/40 border border-emerald-700/40 rounded px-2 py-0.5 text-emerald-300">
                    {REQUIRED_LABELS[can] ?? can} → <span className="font-mono">{String(actual)}</span>
                  </span>
                ))}
              </div>
            </div>
          )}

          {/* Dropdowns for missing columns */}
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {Object.keys(REQUIRED_LABELS).map(canonical => {
              const alreadyMapped = !!mappingData.auto_mapped?.[canonical];
              return (
                <div key={canonical} className={`rounded-xl border p-3 ${alreadyMapped ? 'border-emerald-700/30 opacity-50' : 'border-amber-600/40 bg-slate-900/40'}`}>
                  <label className="block text-xs font-semibold mb-1 text-slate-300">
                    {REQUIRED_LABELS[canonical]}
                    {!alreadyMapped && <span className="text-red-400 ml-1">*</span>}
                  </label>
                  {alreadyMapped ? (
                    <p className="text-xs font-mono text-emerald-400">{mappingData.auto_mapped[canonical]} ✓</p>
                  ) : (
                    <select
                      className="w-full bg-slate-800 border border-slate-600 rounded-lg px-2 py-1.5 text-sm text-slate-200 focus:outline-none focus:border-orange-500"
                      value={userMapping[canonical] ?? ''}
                      onChange={e => setUserMapping(prev => ({ ...prev, [canonical]: e.target.value }))}
                    >
                      <option value="">— اختر عمود —</option>
                      {mappingData.detected_columns.map((col: string) => (
                        <option key={col} value={col}>{col}</option>
                      ))}
                    </select>
                  )}
                  {mappingData.suggestions?.[canonical] && !alreadyMapped && (
                    <p className="text-xs text-slate-500 mt-0.5">
                      مقترح: <span className="font-mono">{mappingData.suggestions[canonical].known_aliases?.slice(0, 3).join(' / ')}</span>
                    </p>
                  )}
                </div>
              );
            })}
          </div>

          <div className="flex gap-3">
            <button
              onClick={confirmMapping}
              disabled={Object.keys(REQUIRED_LABELS).some(k => !userMapping[k] && !mappingData.auto_mapped?.[k])}
              className="flex-1 bg-amber-600 hover:bg-amber-500 disabled:opacity-40 disabled:cursor-not-allowed text-white font-semibold rounded-xl px-4 py-2.5 text-sm transition-colors"
            >
              تأكيد الربط وإعادة الرفع
            </button>
            <button
              onClick={() => { setState('idle'); setMappingData(null); setPendingFile(null); setUserMapping({}); }}
              className="bg-slate-700 hover:bg-slate-600 text-slate-300 rounded-xl px-4 py-2.5 text-sm transition-colors"
            >
              إلغاء
            </button>
          </div>

          {/* Detected columns list */}
          <details className="mt-1">
            <summary className="text-xs text-slate-500 cursor-pointer">الأعمدة المكتشفة في الملف ({mappingData.detected_columns?.length})</summary>
            <p className="text-xs font-mono text-slate-500 mt-1 leading-relaxed">
              {mappingData.detected_columns?.join(' · ')}
            </p>
          </details>
        </div>
      )}

      {/* ── Success card ──────────────────────────────────────────────── */}
      {state === 'success' && result && (
        <div className={`border rounded-2xl p-5 ${result.status === 'cp_survey_inserted' ? 'bg-blue-900/20 border-blue-500/40' : 'bg-emerald-900/20 border-emerald-500/40'}`}>
          <div className="flex items-center justify-between mb-3">
            <div className="flex items-center gap-3">
              <CheckCircle className={`w-6 h-6 shrink-0 ${result.status === 'cp_survey_inserted' ? 'text-blue-400' : 'text-emerald-400'}`} />
              <div>
                <h3 className={`text-base font-bold ${result.status === 'cp_survey_inserted' ? 'text-blue-200' : 'text-emerald-300'}`}>
                  {result.status === 'cp_survey_inserted' ? 'تم استيراد مسح CP بنجاح' : 'تم الرفع بنجاح'}
                </h3>
                {result.status === 'cp_survey_inserted' && result.session_id && (
                  <p className="text-xs text-blue-400/60 font-mono mt-0.5">Session: {result.session_id}</p>
                )}
              </div>
            </div>
            {result.file_type && (
              <span className="text-xs font-mono px-2 py-0.5 rounded bg-slate-800 border border-slate-700 text-slate-400 uppercase">
                {result.file_type} · {result.engine_used}
              </span>
            )}
          </div>

          {/* CP Survey extra info */}
          {result.status === 'cp_survey_inserted' && (
            <div className="mb-3 grid grid-cols-3 gap-2 text-xs">
              <div className="bg-slate-800/50 rounded-lg p-2 border border-slate-700">
                <p className="text-slate-500">نطاق المسافة</p>
                <p className="text-white font-bold">{result.start_distance ?? '—'} → {result.end_distance ?? '—'} م</p>
              </div>
              <div className="bg-slate-800/50 rounded-lg p-2 border border-slate-700">
                <p className="text-slate-500">تاريخ المسح</p>
                <p className="text-white font-bold">{result.survey_date ?? '—'}</p>
              </div>
              <div className="bg-slate-800/50 rounded-lg p-2 border border-slate-700">
                <p className="text-slate-500">ثقة الكشف</p>
                <p className="text-emerald-400 font-bold">{Math.round((result.confidence ?? 0) * 100)}%</p>
              </div>
            </div>
          )}

          {/* Auto-cleaning banner */}
          {result.cleaning_report?.was_cleaned && (
            <div className="flex items-start gap-2 mb-3 bg-blue-900/20 border border-blue-500/30 rounded-xl px-3 py-2">
              <Sparkles className="w-4 h-4 text-blue-400 shrink-0 mt-0.5" />
              <div className="text-xs text-blue-300">
                <span className="font-semibold">تم تنظيف الملف تلقائياً —</span>{' '}
                تم اكتشاف رأس الجدول في السطر {(result.cleaning_report.detected_header_row ?? 0) + 1}
                {result.cleaning_report.columns_removed?.length > 0 && (
                  <span> · حُذف {result.cleaning_report.columns_removed.length} عمود غير ضروري</span>
                )}
                <span> · {result.cleaning_report.rows_cleaned} صف مقبول</span>
              </div>
            </div>
          )}

          <div className="grid grid-cols-3 gap-3 mb-3">
            <StatBox label="إجمالي السطور" value={result.total_rows ?? 0} color="text-white" />
            <StatBox label="نقاط مُدخلة" value={result.inserted ?? 0} color="text-emerald-400" />
            <StatBox label="تم تخطيه" value={result.skipped ?? 0} color="text-amber-400" />
          </div>

          {/* CP survey sample points */}
          {result.status === 'cp_survey_inserted' && result.sample_rows?.length > 0 && (
            <details className="mt-2" open>
              <summary className="text-xs text-blue-400 cursor-pointer mb-2">معاينة أول {result.sample_rows.length} نقاط</summary>
              <div className="overflow-x-auto mt-2">
                <table className="text-xs w-full">
                  <thead>
                    <tr className="text-slate-500">
                      {result.sample_rows[0] && Object.keys(result.sample_rows[0]).slice(0, 6).map((k: string) => (
                        <th key={k} className="text-right pb-1 font-mono">{k}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-800/60">
                    {result.sample_rows.map((r: any, i: number) => (
                      <tr key={i}>
                        {Object.values(r).slice(0, 6).map((v: any, vi: number) => (
                          <td key={vi} className="py-1 text-slate-300">{v != null ? String(v).slice(0, 20) : '—'}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          )}

          {/* Generic sample rows preview */}
          {result.status !== 'cp_survey_inserted' && result.sample_rows?.length > 0 && (
            <details className="mt-2" open>
              <summary className="text-xs text-emerald-400 cursor-pointer mb-2">معاينة أول {result.sample_rows.length} صفوف</summary>
              <div className="overflow-x-auto mt-2">
                <table className="text-xs w-full">
                  <thead>
                    <tr className="text-slate-500">
                      <th className="text-right pb-1">الأصل</th>
                      <th className="text-right pb-1">نوع التدهور</th>
                      <th className="text-right pb-1">القيمة</th>
                      <th className="text-right pb-1">التاريخ</th>
                      <th className="text-right pb-1">الثقة</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-800/60">
                    {result.sample_rows.map((r: any, i: number) => (
                      <tr key={i}>
                        <td className="py-1 font-mono text-slate-400">{String(r.asset_id ?? '').slice(0, 10)}…</td>
                        <td className="py-1 text-orange-300">{r.type}</td>
                        <td className="py-1 text-white font-bold">{r.value}</td>
                        <td className="py-1 text-slate-400">{String(r.timestamp ?? '').slice(0, 10)}</td>
                        <td className="py-1 text-slate-400">{r.confidence}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          )}

          {/* Removed columns detail */}
          {result.cleaning_report?.columns_removed?.length > 0 && (
            <details className="mt-2">
              <summary className="text-xs text-slate-500 cursor-pointer">أعمدة محذوفة ({result.cleaning_report.columns_removed.length})</summary>
              <p className="text-xs text-slate-600 mt-1 font-mono">
                {result.cleaning_report.columns_removed.join(' · ')}
              </p>
            </details>
          )}

          {result.errors?.length > 0 && (
            <details className="mt-2">
              <summary className="text-xs text-amber-400 cursor-pointer">عرض الأخطاء ({result.errors.length})</summary>
              <div className="mt-2 space-y-1 max-h-32 overflow-y-auto">
                {result.errors.map((e: string, i: number) => (
                  <p key={i} className="text-xs text-amber-300/70">{e}</p>
                ))}
              </div>
            </details>
          )}
          {result.triggered_analysis?.length > 0 && (
            <p className="text-xs text-emerald-400/70 mt-2 flex items-center gap-1">
              <Activity className="w-3.5 h-3.5" />
              تم تشغيل محرك التحليل لـ {result.triggered_analysis.length} أصل
            </p>
          )}
          <button
            onClick={() => { setState('idle'); setResult(null); }}
            className="mt-3 text-xs text-slate-500 hover:text-slate-300 underline transition-colors"
          >
            رفع ملف آخر
          </button>
        </div>
      )}

      {state === 'error' && result && (
        <div className="bg-red-900/20 border border-red-500/40 rounded-2xl p-5 flex items-start gap-3">
          <XCircle className="w-6 h-6 text-red-400 shrink-0 mt-0.5" />
          <div className="flex-1 min-w-0">
            <h3 className="text-base font-bold text-red-300 mb-1">
              {result.status === 'unsupported_format' ? 'صيغة الملف غير مدعومة' : 'فشل الرفع'}
            </h3>
            <p className="text-sm text-red-400/80 mb-1">{result.message ?? result.detail ?? JSON.stringify(result)}</p>
            {result.action && (
              <p className="text-xs text-amber-300/80 mt-1">
                <span className="font-semibold">الإجراء المطلوب: </span>{result.action}
              </p>
            )}
            {result.how_to_convert && (
              <p className="text-xs text-slate-400 mt-1">{result.how_to_convert}</p>
            )}
          </div>
        </div>
      )}

      {/* ── CP Survey format guide ────────────────────────────────────── */}
      <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-5">
        <h3 className="text-base font-semibold text-white mb-3 flex items-center gap-2">
          <FileText className="w-5 h-5 text-slate-400" />
          تنسيق ملف مسح الحماية الكاثودية
        </h3>
        <p className="text-xs text-slate-500 mb-4">
          النظام يكتشف ملفات مسح CP تلقائياً بثقة عالية. تأكد من احتواء الملف على الأعمدة التالية:
        </p>
        <div className="overflow-x-auto">
          <table className="text-sm w-full">
            <thead>
              <tr className="text-slate-400 text-xs border-b border-slate-800">
                <th className="text-right pb-2 font-semibold">العمود في الملف</th>
                <th className="text-right pb-2 font-semibold">المعنى</th>
                <th className="text-right pb-2 font-semibold">إلزامي؟</th>
                <th className="text-right pb-2 font-semibold">مثال</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-800/50">
              {[
                ['Distance / Chainage / KP', 'الموقع على الخط (م)', '✅', '327+500 أو 1250.5'],
                ['Natural Potential / NP', 'الجهد الكهروكيميائي (V)', '✅', '-0.750'],
                ['As-Found / On-Potential', 'قراءة On-Potential', '—', '-0.850'],
                ['As-Left / Off-Potential', 'قراءة Off-Potential', '—', '-0.920'],
                ['Instant Off / Inst-Off', 'قراءة Instant Off', '—', '-0.885'],
                ['Date / Timestamp', 'تاريخ نقطة القياس', '—', '2024-03-15'],
              ].map(([col, meaning, req, ex]) => (
                <tr key={col} className="hover:bg-slate-800/30">
                  <td className="py-2 font-mono text-cyan-300 text-xs">{col}</td>
                  <td className="py-2 text-slate-300 text-xs">{meaning}</td>
                  <td className="py-2 text-center text-sm">{req}</td>
                  <td className="py-2 text-slate-500 text-xs font-mono">{ex}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div className="mt-4 grid grid-cols-1 md:grid-cols-3 gap-3">
          {[
            { label: 'حد الحماية', value: '−850 mV', desc: 'NACE SP0169 — حد الحماية الكاثودية الكافية', color: 'text-emerald-400', bg: 'bg-emerald-900/20 border-emerald-500/20' },
            { label: 'الصيغ المقبولة', value: 'XLS · XLSX · CSV', desc: 'الملفات متعددة الأوراق مدعومة — يكتشف النظام الورقة الصحيحة', color: 'text-blue-400', bg: 'bg-blue-900/20 border-blue-500/20' },
            { label: 'الكشف التلقائي', value: 'ذكاء اصطناعي', desc: 'يتعرف النظام تلقائياً على صفوف العنوان ومسلسلات القياس', color: 'text-purple-400', bg: 'bg-purple-900/20 border-purple-500/20' },
          ].map(item => (
            <div key={item.label} className={`rounded-xl border p-3 ${item.bg}`}>
              <p className={`text-sm font-bold ${item.color}`}>{item.label}: {item.value}</p>
              <p className="text-xs text-slate-500 mt-1">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

// ─── Small helpers ────────────────────────────────────────────────────────────

function KpiCard({
  label, value, icon, color, highlight,
}: {
  label: string; value: number | string;
  icon: React.ReactNode; color: string; highlight?: boolean;
}) {
  return (
    <div className={`bg-slate-900/60 rounded-xl border ${color} p-4 flex items-center gap-3`}>
      <div className="shrink-0">{icon}</div>
      <div>
        <p className={`text-2xl font-bold ${highlight ? 'text-red-400' : 'text-white'}`}>{value}</p>
        <p className="text-xs text-slate-400 mt-0.5">{label}</p>
      </div>
    </div>
  );
}

function StatBox({ label, value, color }: { label: string; value: number; color: string }) {
  return (
    <div className="bg-slate-900/60 rounded-xl p-3 text-center border border-slate-700/60">
      <p className={`text-2xl font-bold ${color}`}>{value}</p>
      <p className="text-xs text-slate-500 mt-0.5">{label}</p>
    </div>
  );
}

function EmptyState({ msg }: { msg: string }) {
  return (
    <div className="bg-slate-900/50 rounded-2xl border border-slate-800 p-10 text-center">
      <Info className="w-10 h-10 mx-auto mb-3 text-slate-600" />
      <p className="text-slate-400">{msg}</p>
    </div>
  );
}

function UploadDetailPanel({
  detail,
  viewMode,
  onClose,
}: {
  detail: UploadDetail;
  viewMode: 'specialist' | 'manager';
  onClose: () => void;
}) {
  const successRate = detail.total_rows > 0
    ? ((detail.inserted_rows / detail.total_rows) * 100).toFixed(1)
    : '0.0';

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm">
      <div className="bg-slate-900 border border-slate-700 rounded-2xl shadow-2xl w-full max-w-3xl max-h-[90vh] overflow-y-auto">
        {/* Header */}
        <div className="flex items-center justify-between px-6 py-4 border-b border-slate-800 sticky top-0 bg-slate-900 z-10">
          <div className="flex items-center gap-3">
            <Database className="w-5 h-5 text-orange-400" />
            <h2 className="text-base font-bold text-white truncate max-w-xs">{detail.filename}</h2>
            <span className={`px-2 py-0.5 rounded-md text-xs border font-medium ${STATUS_BADGE[detail.processing_status] ?? STATUS_BADGE['error']}`}>
              {detail.processing_status === 'success' ? 'نجاح' : detail.processing_status === 'partial' ? 'جزئي' : 'خطأ'}
            </span>
          </div>
          <button onClick={onClose} className="text-slate-400 hover:text-white text-xl leading-none">&times;</button>
        </div>

        <div className="p-6 space-y-5">
          {/* Stats Grid */}
          <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
            {[
              { label: 'إجمالي الصفوف', value: detail.total_rows, color: 'text-slate-200' },
              { label: 'مُدرَج', value: detail.inserted_rows, color: 'text-emerald-400' },
              { label: 'مُتخطَّى', value: detail.skipped_rows, color: 'text-amber-400' },
              { label: 'فاشل', value: detail.failed_rows, color: 'text-red-400' },
            ].map(s => (
              <div key={s.label} className="bg-slate-800/60 rounded-xl border border-slate-700 p-3 text-center">
                <p className={`text-2xl font-bold ${s.color}`}>{s.value}</p>
                <p className="text-xs text-slate-500 mt-1">{s.label}</p>
              </div>
            ))}
          </div>

          {/* Success Rate Bar */}
          <div>
            <div className="flex items-center justify-between mb-1.5">
              <span className="text-sm text-slate-400">نسبة النجاح</span>
              <span className="text-sm font-bold text-white">{successRate}%</span>
            </div>
            <div className="h-2.5 bg-slate-800 rounded-full overflow-hidden">
              <div
                className={`h-full rounded-full transition-all ${parseFloat(successRate) >= 80 ? 'bg-emerald-500' : parseFloat(successRate) >= 50 ? 'bg-amber-500' : 'bg-red-500'}`}
                style={{ width: `${successRate}%` }}
              />
            </div>
          </div>

          {/* Metadata */}
          <div className="grid grid-cols-2 gap-3 text-sm">
            {[
              { label: 'تاريخ الرفع', value: new Date(detail.upload_timestamp).toLocaleString('ar-SA') },
              { label: 'تاريخ المسح', value: detail.survey_date ?? '—' },
              { label: 'Pipeline', value: detail.pipeline_id ?? '—' },
              { label: 'نوع الملف', value: detail.file_type ?? '—' },
              { label: 'صف الرأسية', value: detail.detected_header_row != null ? `صف ${detail.detected_header_row}` : '—' },
              { label: 'المحرك', value: detail.engine_used ?? '—' },
            ].map(m => (
              <div key={m.label} className="flex items-start gap-2">
                <span className="text-slate-500 shrink-0">{m.label}:</span>
                <span className="text-slate-300 font-medium">{m.value}</span>
              </div>
            ))}
          </div>

          {/* Sheets Info */}
          {(detail.sheets_processed || detail.sheets_skipped) && (
            <div className="bg-slate-800/40 rounded-xl border border-slate-700 p-4 space-y-2">
              <h4 className="text-sm font-semibold text-slate-300">الأوراق (Sheets)</h4>
              {detail.sheets_processed && detail.sheets_processed.length > 0 && (
                <div className="flex flex-wrap gap-1.5">
                  <span className="text-xs text-slate-500 self-center">معالجة:</span>
                  {detail.sheets_processed.map(s => (
                    <span key={s} className="px-2 py-0.5 rounded-md bg-emerald-900/40 border border-emerald-600/40 text-emerald-300 text-xs">{s}</span>
                  ))}
                </div>
              )}
              {detail.sheets_skipped && detail.sheets_skipped.length > 0 && (
                <div className="flex flex-wrap gap-1.5">
                  <span className="text-xs text-slate-500 self-center">متخطاة:</span>
                  {detail.sheets_skipped.map(s => (
                    <span key={s} className="px-2 py-0.5 rounded-md bg-slate-700 border border-slate-600 text-slate-400 text-xs">{s}</span>
                  ))}
                </div>
              )}
            </div>
          )}

          {/* Manager view: plain language summary */}
          {viewMode === 'manager' && (
            <div className={`rounded-xl border p-4 ${detail.processing_status === 'success' ? 'bg-emerald-900/20 border-emerald-600/30' : 'bg-amber-900/20 border-amber-600/30'}`}>
              <h4 className="text-sm font-bold text-slate-200 mb-2 flex items-center gap-2">
                <Briefcase className="w-4 h-4" /> ملخص تنفيذي
              </h4>
              <p className="text-sm text-slate-300">
                تم رفع الملف <strong className="text-white">{detail.filename}</strong> بنجاح {detail.processing_status === 'success' ? 'كامل' : 'جزئي'}.
                {' '} أُدرج <strong className="text-emerald-400">{detail.inserted_rows}</strong> سجل من أصل <strong className="text-white">{detail.total_rows}</strong>{' '}
                (معدل النجاح: <strong className="text-white">{successRate}%</strong>).
                {detail.failed_rows > 0 && ` فشل ${detail.failed_rows} سجل.`}
              </p>
            </div>
          )}

          {/* Specialist view: column mapping + cleaning report + sample rows */}
          {viewMode === 'specialist' && (
            <>
              {detail.column_mapping && Object.keys(detail.column_mapping).length > 0 && (
                <div>
                  <h4 className="text-sm font-semibold text-slate-300 mb-2">تعيين الأعمدة</h4>
                  <div className="bg-slate-800/40 rounded-xl border border-slate-700 overflow-hidden">
                    <table className="w-full text-xs">
                      <thead>
                        <tr className="border-b border-slate-700 bg-slate-800/60">
                          <th className="px-3 py-2 text-right text-slate-400">عمود الملف</th>
                          <th className="px-3 py-2 text-right text-slate-400">عمود النظام</th>
                        </tr>
                      </thead>
                      <tbody>
                        {Object.entries(detail.column_mapping).map(([src, dst]) => (
                          <tr key={src} className="border-b border-slate-800/50">
                            <td className="px-3 py-1.5 text-slate-400 font-mono">{src}</td>
                            <td className="px-3 py-1.5 text-emerald-300 font-mono">{dst}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}

              {detail.sample_rows && detail.sample_rows.length > 0 && (
                <div>
                  <h4 className="text-sm font-semibold text-slate-300 mb-2">عينة البيانات (أول {detail.sample_rows.length} صفوف)</h4>
                  <div className="bg-slate-800/40 rounded-xl border border-slate-700 overflow-x-auto">
                    <table className="w-full text-xs whitespace-nowrap">
                      <thead>
                        <tr className="border-b border-slate-700 bg-slate-800/60">
                          {Object.keys(detail.sample_rows[0]).map(k => (
                            <th key={k} className="px-3 py-2 text-right text-slate-400 font-mono">{k}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {detail.sample_rows.map((row, ri) => (
                          <tr key={ri} className="border-b border-slate-800/50">
                            {Object.values(row).map((v: any, vi) => (
                              <td key={vi} className="px-3 py-1.5 text-slate-300">{v != null ? String(v) : '—'}</td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}
            </>
          )}

          {/* Errors */}
          {detail.error_messages && detail.error_messages.length > 0 && (
            <div className="bg-red-900/20 border border-red-600/30 rounded-xl p-4">
              <h4 className="text-sm font-bold text-red-300 mb-2">رسائل الخطأ</h4>
              <ul className="space-y-1">
                {detail.error_messages.map((e, i) => (
                  <li key={i} className="text-xs text-red-400 font-mono">{e}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
