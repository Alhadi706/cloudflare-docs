function departmentToRoute(dept: ActivatedDept): string {
  if (dept.frontend_route) return dept.frontend_route;
  const code = (dept.department_code ?? '').toLowerCase();
  const name = `${dept.name_ar ?? ''} ${dept.custom_name_ar ?? ''}`.toLowerCase();

  if (code.includes('eng') || code.includes('gis') || name.includes('هندس')) return '/dashboard/map-shell?pack=engineering';
  if (code.includes('fin') || name.includes('مالي')) return '/dashboard/map-shell?pack=finance';
  if (code.includes('exec') || name.includes('تنفيذي')) return '/dashboard/map-shell?pack=executive';
  if (code.includes('admin') || name.includes('إدار')) return '/dashboard/map-shell?pack=administration';

  return `/dashboard/departments/${code.replace('dept_', '')}`;
}

function resolveTenantId(): string {
  if (typeof window === 'undefined') return 'aaaaaaaa-0000-4000-a000-000000000001';
  return (
    localStorage.getItem('tenant_id') ||
    localStorage.getItem('active_tenant_id') ||
    'aaaaaaaa-0000-4000-a000-000000000001'
  );
}

export default function DashboardHome() {
  const router = useRouter();
  const [displayName, setDisplayName] = useState('مرحباً');
  const [employeesCount, setEmployeesCount] = useState(0);
  const [warehousesCount, setWarehousesCount] = useState(0);
  const [budgetTotal, setBudgetTotal] = useState(0);
  const { departments } = useActivatedDepartments();

  useEffect(() => {
    try {
      const user = JSON.parse(localStorage.getItem('current_user') || '{}');
      setDisplayName(user.full_name || user.email || 'مرحباً');
    } catch {
      setDisplayName('مرحباً');
    }
  }, []);

  useEffect(() => {
    const tenantId = resolveTenantId();
    const headers: HeadersInit = { 'X-Tenant-ID': tenantId };

    (async () => {
      try {
        const [empRes, whRes, mapSummaryRes] = await Promise.all([
          fetch(`/api/v1/erp-spatial/employees/geojson?tenant_id=${encodeURIComponent(tenantId)}`, { headers }),
          fetch(`/api/v1/erp-spatial/warehouses/geojson?tenant_id=${encodeURIComponent(tenantId)}`, { headers }),
          fetch('/api/v1/map/summary', { headers }),
        ]);

        if (empRes.ok) {
          const emp = await empRes.json();
          setEmployeesCount(Array.isArray(emp?.features) ? emp.features.length : 0);
        }
        if (whRes.ok) {
          const wh = await whRes.json();
          setWarehousesCount(Array.isArray(wh?.features) ? wh.features.length : 0);
        }
        if (mapSummaryRes.ok) {
          const summary = await mapSummaryRes.json();
          const val = Number(summary?.kpis?.total_budget?.value ?? 0);
          setBudgetTotal(Number.isFinite(val) ? val : 0);
        }
      } catch {
        // Keep UI responsive even if one endpoint is unavailable.
      }
    })();
  }, []);

  const logout = () => {
    localStorage.clear();
    document.cookie = 'auth_session=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
    router.push('/entry');
  };

  const activeDepartments = sidebarDepts(departments);
  const dynamicActions = activeDepartments.map((dept) => ({
    title: dept.custom_name_ar ?? dept.name_ar,
    href: departmentToRoute(dept),
    icon: Building2,
    desc: `الدخول إلى ${dept.custom_name_ar ?? dept.name_ar}`,
  }));

  const actionMap = new Map<string, { title: string; href: string; icon: typeof Building2; desc: string }>();
  [...coreActions, ...dynamicActions].forEach((item) => {
    if (!actionMap.has(item.href)) actionMap.set(item.href, item);
  });
  const quickActions = Array.from(actionMap.values());

  return (
    <div className="relative min-h-screen bg-transparent px-4 py-4 md:px-6" dir="rtl">
      <button
        type="button"
        onClick={logout}
        className="fixed top-4 left-4 z-30 rounded-xl border border-slate-300/70 bg-white/80 px-3 py-1.5 text-xs font-semibold text-slate-900 backdrop-blur-xl transition-colors hover:bg-white"
      >
        تسجيل الخروج
      </button>

      <div className="pointer-events-none mx-auto w-full max-w-7xl">
        <div className="flex flex-wrap items-start gap-3 md:gap-4">
          <div className="pointer-events-auto rounded-2xl border border-slate-300/70 bg-white/80 px-4 py-3 backdrop-blur-xl transition-all duration-300 hover:bg-white">
            <p className="text-[11px] text-slate-700">الموظفون</p>
            <p className="text-2xl font-bold text-blue-950 tabular-nums">{employeesCount.toLocaleString('ar-LY')}</p>
          </div>
          <div className="pointer-events-auto rounded-2xl border border-slate-300/70 bg-white/80 px-4 py-3 backdrop-blur-xl transition-all duration-300 hover:bg-white">
            <p className="text-[11px] text-slate-700">المخازن</p>
            <p className="text-2xl font-bold text-blue-950 tabular-nums">{warehousesCount.toLocaleString('ar-LY')}</p>
          </div>
          <div className="pointer-events-auto rounded-2xl border border-slate-300/70 bg-white/80 px-4 py-3 backdrop-blur-xl transition-all duration-300 hover:bg-white">
            <p className="text-[11px] text-slate-700">إجمالي الميزانية</p>
            <p className="text-2xl font-bold text-blue-950 tabular-nums">{budgetTotal.toLocaleString('ar-LY', { maximumFractionDigits: 0 })}</p>
            <p className="text-[11px] text-slate-600">د.ل</p>
          </div>
          <div className="pointer-events-auto rounded-2xl border border-slate-300/70 bg-white/80 px-4 py-3 backdrop-blur-xl">
            <p className="text-sm font-semibold text-blue-950">{displayName}</p>
            <p className="text-[11px] text-slate-700">غرفة السيادة التشغيلية</p>
          </div>
        </div>
      </div>

      <div className="absolute bottom-6 right-6 z-20 w-[360px] max-w-[calc(100vw-2rem)] max-h-[62vh] space-y-2 overflow-y-auto pr-1" dir="rtl">
        {quickActions.map((action) => {
          const Icon = action.icon;
          return (
            <Link
              key={action.href}
              href={action.href}
              className="group flex items-center justify-between rounded-2xl border border-slate-300/70 bg-white/80 px-4 py-3 backdrop-blur-xl transition-all duration-300 hover:-translate-y-0.5 hover:bg-white"
            >
              <div>
                <p className="text-sm font-bold text-blue-950">{action.title}</p>
                <p className="text-[11px] text-slate-700">{action.desc}</p>
              </div>
              <div className="flex items-center gap-2 text-blue-900">
                <Icon className="h-4 w-4" />
                <ArrowUpRight className="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </div>
            </Link>
          );
        })}
      </div>

      <div className="absolute top-24 right-6 z-20 hidden md:block" dir="rtl">
        <div className="rounded-2xl border border-slate-300/70 bg-gradient-to-br from-white/85 to-white/70 px-4 py-3 backdrop-blur-xl">
          <p className="text-xs font-semibold text-blue-950">المشهد السيادي المباشر</p>
          <p className="mt-1 text-[11px] text-slate-700">جميع الوحدات تعمل فوق الخريطة الحية بدون مقاطعة الرؤية</p>
          <p className="mt-2 text-[10px] text-emerald-300">LIVE</p>
        </div>
      </div>
    </div>
  );
}
